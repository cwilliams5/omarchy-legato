#!/usr/bin/python3 -I
"""legato-bridge — the Pocket Casts and mpv helper behind Legato, a Pocket Casts player for the Omarchy bar.

The QML side never talks HTTP or to the player itself. It runs this script
with one subcommand per request and reads exactly one JSON object from stdout:

    {"ok": true,  "data": ...}
    {"ok": false, "code": "<machine code>", "error": "<human text>"}

Handled failures (signed out, network, no player, ...) still exit 0 so the
shell can branch on `code`; only an unexpected crash exits non-zero.

Pocket Casts has no public API. This talks to the same endpoints the Pocket
Casts web player uses (api.pocketcasts.com), which can change without notice.
Login takes your email and password once, read from stdin, and keeps only the
access and refresh tokens Pocket Casts hands back, in
$XDG_STATE_HOME/omarchy-legato/auth.json (0600). The password is never
written anywhere.

Audio plays in mpv, started detached by this script and driven over its JSON
IPC socket in $XDG_RUNTIME_DIR/omarchy-legato/ (0700). Playback outlives
the shell; every `player` poll pushes the listening position back to Pocket
Casts so your phone picks up where this machine left off, and the other way
round: before a paused episode plays again, Pocket Casts is asked where you
are, so a resume here never rewinds what you heard elsewhere (check_server).
When mpv-mpris is installed, media keys and playerctl see it too.

Trust boundaries: the bridge runs under an isolated interpreter
(`/usr/bin/python3 -I`) with a scrubbed environment; mpv (and hyprctl, for
the video window's placement) is an absolute path from root-owned system
directories started with a rebuilt environment, mpv with --no-config; it is only ever handed http(s) URLs; every file the bridge reads
or writes is opened relative to a held, checked directory descriptor without
following symlinks; and every HTTP body is read against a byte cap and an
overall deadline.

Only Python's standard library is used.
"""

import argparse
import base64
import contextlib
import errno
import fcntl
import hashlib
import hmac
import http.client as http_client
import ipaddress
import json
import pwd
import re
import os
import secrets
import select
import signal
import socket
import ssl
import stat
import struct
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import zlib
from concurrent.futures import ThreadPoolExecutor

API = "https://api.pocketcasts.com"
PODCAST_API = "https://podcast-api.pocketcasts.com"
ART_BASE = "https://static.pocketcasts.com/discover/images"
USER_AGENT = "legato/1.0 (+https://github.com/cwilliams5/omarchy-legato)"

HTTP_TIMEOUT = 15
# A sign-in refresh's own timeout: the resume check's short limit
# (http_timeout) never applies to it, since a refresh cut short after Pocket
# Casts answered could lose a rotated refresh token. (The sleep guard doesn't
# refresh at all.)
TOKEN_TIMEOUT = 15
# False only in the sleep guard's push: no sign-in refresh there (refresh_tokens).
REFRESH_ALLOWED = True
ART_TIMEOUT = 8
ART_WORKERS = 8
ART_SIZE = 200
ART_MAX_BYTES = 1024 * 1024  # covers are tens of KB
# API replies are JSON well below this; a show's full episode list (served
# gzipped from a CDN) is the largest thing fetched, and is capped after
# decompression too.
API_MAX_BYTES = 4 * 1024 * 1024
SHOW_MAX_BYTES = 24 * 1024 * 1024
ERROR_MAX_BYTES = 64 * 1024
# Hosts the bridge will talk to: the API with the bearer token, and the
# episode-list CDN and artwork host without it.
API_HOST = "api.pocketcasts.com"
SHOW_HOSTS = ("podcast-api.pocketcasts.com", "podcasts.pocketcasts.com", "cache.pocketcasts.com")
ART_HOST_RE = re.compile(r"^static\.pocketcasts\.com$")
ART_NAME_RE = re.compile(r"^[0-9a-f]{28}\.jpg$")

AUTH_MAX_BYTES = 64 * 1024
STATE_MAX_BYTES = 64 * 1024

UUID_RE = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
EMAIL_RE = re.compile(r"^[^@\s]{1,128}@[^@\s]{1,253}$")

# Pocket Casts' playingStatus values.
STATUS_UNPLAYED = 1
STATUS_IN_PROGRESS = 2
STATUS_PLAYED = 3

# Push the position to Pocket Casts at most this often while playing.
SYNC_INTERVAL = 30
# Pocket Casts and this machine agree on a position to within this many
# seconds; a bigger gap means another device moved it.
DRIFT_SLACK = 3
# While playing, this long since the last push means playback was
# interrupted (paused from a media key, the machine slept, the shell was
# down), so Pocket Casts is asked where things stand before the next push.
RECHECK_AFTER = 90
# Within this many seconds of the end counts as finished.
FINISH_SLACK = 3
# The resume check's two requests wait this long (not HTTP_TIMEOUT): when
# Pocket Casts can't answer, the episode plays anyway and nothing is pushed
# until it does, so a hanging network shouldn't hold up Play for 30 s.
RESUME_CHECK_TIMEOUT = 5
# Listening stats (stats.json): a stretch between two counts longer than this
# isn't counted (the shell was down, say), nor one where the episode moved
# implausibly for its speed (a seek from a media widget, a stall).
LISTEN_GAP_MAX = 300
# After a seek from elsewhere (count_listening's `seeked`), a stretch is
# counted only if it's no longer than a poll's (32 s, with grace).
SEEKED_STRETCH_MAX = 40
STATS_KEYS = ("listened", "speed", "trim", "skipping", "intro", "outro")
# mpv sits at "end of file" both at an episode's real end and where its stream
# broke off for good (stream_broke). Its watcher (legato-watch.lua) records
# where FFmpeg saw a sized stream end short; mpv having read this far past
# that spot means a reconnect worked and the stream went on.
READ_PAST_CUT = 64 * 1024
# A stream read straight through (a host without byte ranges) ends where its
# size says: mpv stops this close to it at a real end (about 100 bytes for an
# MP3's trailing tag, 81 for an M4A) and far short at a break.
READ_TO_END = 4096
# Periodic pushes failing this many times in a row (a minute and more): said.
PUSH_FAILURES_SAID = 2
# Stuck this long (mpv buffering, nothing arriving), the stream counts as
# interrupted, like a pause: its position isn't pushed (you may have carried
# on with your phone meanwhile), and playing on asks Pocket Casts first.
STALL_AFTER = 15
# An end this far short of the length Pocket Casts lists proves nothing (a
# placeholder clip): end_unproven.
END_FAR_SHORT = 0.5
# With no size from the host (or no watcher), an end counts only within this
# share of the longest duration given (Pocket Casts', mpv's), or BROKE_SLACK
# seconds if that's more: podcast files and their listed durations differ by
# a few minutes (ads inserted on the fly). The same share decides whether
# mpv's duration agrees with Pocket Casts' enough to skip a show's outro.
NO_SIZE_MARGIN = 0.10
BROKE_SLACK = 10
# A load that started this far short of where it was asked couldn't start
# part way (below_start).
START_SLACK = 5
# A break's position Pocket Casts never got is kept this long (resume_last).
UNSENT_BREAK_KEPT = 3600
# Extra mpv arguments; the test suite sets --ao=null here.
MPV_EXTRA_ARGS = ()
SPEEDS = (0.8, 1.0, 1.1, 1.2, 1.3, 1.5, 1.7, 2.0, 2.5, 3.0)

# Trim Silence, with Pocket Casts' own values (its Android app,
# ShiftyAudioProcessorChain.kt): a pause longer than the first number is cut
# down to the second; silence is anything below amplitude 250 of 32768
# (-42 dBFS), judged by peak. Speed applies after trimming: mpv runs user
# filters before its scaletempo2.
TRIM_LEVELS = {
    "off": None,
    "mild": (0.416, 0.291),
    "medium": (0.300, 0.225),
    "madmax": (0.083, 0.0),
}
TRIM_ORDER = ("off", "mild", "medium", "madmax")
TRIM_NAMES = {"off": "Off", "mild": "Mild", "medium": "Medium", "madmax": "Mad Max"}  # as Pocket Casts names them
TRIM_LABEL = "@trim"

# Volume Boost, as in the Pocket Casts apps: Android's LoudnessEnhancer at a
# 1000 mB (+10 dB) target (ShiftyCustomAudio.kt). Here the same gain goes
# into a limiter, so peaks don't clip; its auto-level stays off (it would
# undo the boost) and its delay is compensated (video stays in sync). It
# runs after Trim Silence, which must judge silence before anything is
# made louder.
BOOST_FILTER = "lavfi=[alimiter=level_in=3.1623:limit=0.89:attack=5:release=50:level=false:latency=true]"
BOOST_LABEL = "@boost"


def safe_uuid(value):
    """Pocket Casts IDs are UUIDs. Anything else must not reach a URL path."""
    s = str(value or "").strip().lower()
    if not UUID_RE.match(s):
        raise ApiError("bad_args", "Not a Pocket Casts ID: %r" % s[:40])
    return s


def safe_media_url(value):
    """Episode audio can live on any host, so only the scheme is pinned:
    http(s) and nothing mpv would treat as a protocol of its own (lavfi://,
    av://, file paths, edl://...)."""
    s = str(value or "").strip()
    if not s or len(s) > 4096 or CONTROL_RE.search(s):
        return ""
    try:
        parts = urllib.parse.urlsplit(s)
    except ValueError:
        return ""
    if parts.scheme not in ("http", "https") or not parts.hostname:
        return ""
    return s

# --------------------------------------------------------------------- output

def out(data):
    sys.stdout.write(json.dumps({"ok": True, "data": data}, ensure_ascii=False))
    sys.stdout.write("\n")
    sys.stdout.flush()


def fail(code, message, extra=None):
    payload = {"ok": False, "code": code, "error": message}
    if extra:
        payload.update(extra)
    sys.stdout.write(json.dumps(payload, ensure_ascii=False))
    sys.stdout.write("\n")
    sys.stdout.flush()


class ApiError(Exception):
    def __init__(self, code, message, status=0, retry_after=0):
        super().__init__(message)
        self.code = code
        self.message = message
        self.status = status
        self.retry_after = retry_after


# --------------------------------------------------------------- environment
#
# Nothing the bridge starts is looked up through the session PATH, and nothing
# it starts sees the session's environment. Programs come from a fixed list of
# root-owned system directories, and each child gets a rebuilt environment
# holding only what that child needs.

# /usr/local/bin and anything under $HOME are deliberately absent: those are
# the usual landing spots for a shadow binary.
TRUSTED_BIN_DIRS = ("/usr/bin", "/bin", "/usr/sbin", "/sbin", "/run/current-system/sw/bin")
TRUSTED_PATH = ":".join(TRUSTED_BIN_DIRS)

# Directory variables, honoured only as clean absolute paths. XDG_RUNTIME_DIR
# is also where mpv finds PipeWire/PulseAudio.
PATH_ENV_NAMES = ("HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME", "XDG_CONFIG_HOME",
                  "XDG_DATA_HOME", "XDG_RUNTIME_DIR")
# What mpv-mpris needs to publish the player on the session bus.
BUS_ENV_NAMES = ("USER", "LOGNAME", "LANG", "DBUS_SESSION_BUS_ADDRESS")
# The video window: the Wayland display mpv draws it on (found in
# XDG_RUNTIME_DIR), and what hyprctl needs to find Hyprland's socket for its
# placement. Without WAYLAND_DISPLAY, mpv silently can't select a video track.
HYPR_ENV_NAMES = ("WAYLAND_DISPLAY", "HYPRLAND_INSTANCE_SIGNATURE")
ALLOWED_ENV_NAMES = PATH_ENV_NAMES + BUS_ENV_NAMES + HYPR_ENV_NAMES
TOOL_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$")
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")


def clean_env_value(name, value):
    """`value` when it is a bounded single-line string (and, for a directory
    variable, a normalized absolute path); "" for anything else."""
    if not isinstance(value, str) or not value or len(value) > 4096 or CONTROL_RE.search(value):
        return ""
    if name in PATH_ENV_NAMES:
        if not value.startswith("/") or value.startswith("//") or os.path.normpath(value) != value:
            return ""
    return value


def scrub_environment():
    """Replace the inherited environment with the allow-listed variables and a
    fixed PATH before anything consults it — urllib's proxy lookup, ssl's
    SSL_CERT_FILE, subprocess resolution. The interpreter itself already runs
    with -I, so PYTHON* variables and user site-packages never applied."""
    kept = {}
    for name in ALLOWED_ENV_NAMES:
        value = clean_env_value(name, os.environ.get(name))
        if value:
            kept[name] = value
    os.environ.clear()
    os.environ.update(kept)
    os.environ["PATH"] = TRUSTED_PATH


def child_env():
    """The complete environment for mpv: the fixed PATH, the directory and
    session-bus variables, and nothing else (LD_PRELOAD, BASH_ENV, exported
    shell functions, proxies are never carried over)."""
    env = {"PATH": TRUSTED_PATH}
    for name in PATH_ENV_NAMES + BUS_ENV_NAMES + HYPR_ENV_NAMES:
        value = clean_env_value(name, os.environ.get(name))
        if value:
            env[name] = value
    return env


def home():
    return clean_env_value("HOME", os.environ.get("HOME")) or pwd.getpwuid(os.geteuid()).pw_dir


def xdg_home(name, *fallback):
    return clean_env_value(name, os.environ.get(name)) or os.path.join(home(), *fallback)


def safe_chain(path, owners):
    """True when every component of the absolute, symlink-free `path`, from /
    down to and including its last one, exists, is owned by one of `owners`,
    and is writable by nobody else. A root-owned sticky directory (/tmp,
    /nix/store) is allowed along the way: nobody but an entry's owner can
    rename or remove what is in it."""
    parts = path.split("/")
    for i in range(1, len(parts) + 1):
        prefix = "/".join(parts[:i]) or "/"
        try:
            st = os.lstat(prefix)
        except OSError:
            return False
        if stat.S_ISLNK(st.st_mode) or st.st_uid not in owners:
            return False
        if st.st_mode & 0o022 and not (st.st_uid == 0 and stat.S_ISDIR(st.st_mode) and st.st_mode & stat.S_ISVTX):
            return False
    return True


def trusted_tool(name, dirs=TRUSTED_BIN_DIRS):
    """Absolute path of `name` in the first trusted directory holding it, or ""
    — never a PATH lookup. The file it resolves to, and every directory on the
    way to it, must be root-owned and writable by nobody else."""
    if not TOOL_NAME_RE.match(name or ""):
        return ""
    for directory in dirs:
        candidate = directory + "/" + name
        try:
            st = os.stat(candidate)
        except OSError:
            continue
        if not stat.S_ISREG(st.st_mode) or not st.st_mode & 0o111:
            continue
        if safe_chain(os.path.realpath(directory), (0,)) and safe_chain(os.path.realpath(candidate), (0,)):
            return candidate
    return ""


# ------------------------------------------------------------ private files
#
# Every file the bridge touches lives below a directory it holds open by
# descriptor, and every operation on it is relative to that descriptor, so a
# pathname swapped afterwards cannot redirect a read or a write.

DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
READ_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK | os.O_NOCTTY
CREATE_FLAGS = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC
MAX_SYMLINK_HOPS = 16
ENTRY_NAME_RE = re.compile(r"^(?!\.\.?$)[A-Za-z0-9._-]{1,128}$")


class UnsafePath(ApiError):
    def __init__(self, message):
        super().__init__("unsafe_path", message)


class HeldDir:
    """A directory held open by descriptor; `path` is only for messages and for
    telling the panel where cover art landed."""

    def __init__(self, fd, path):
        self.fd = fd
        self.path = path

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()

    def close(self):
        if self.fd >= 0:
            os.close(self.fd)
            self.fd = -1

    def entry(self, name):
        return self.path.rstrip("/") + "/" + name


def _check_dir(st, where):
    if not stat.S_ISDIR(st.st_mode):
        raise UnsafePath("%s is not a directory" % where)
    if st.st_uid not in (0, os.geteuid()):
        raise UnsafePath("%s is owned by another user" % where)
    if st.st_mode & 0o022 and not (st.st_uid == 0 and st.st_mode & stat.S_ISVTX):
        raise UnsafePath("%s is writable by other users" % where)


def _open_child(parent_fd, name, where, create):
    """Open one directory component below `parent_fd` without following a
    symlink. Returns (fd, None), or (None, target) when the entry is a symlink,
    so the caller decides whether one is acceptable there."""
    try:
        st = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except FileNotFoundError:
        if not create:
            raise
        try:
            os.mkdir(name, 0o700, dir_fd=parent_fd)
        except FileExistsError:
            pass
        st = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    if stat.S_ISLNK(st.st_mode):
        if st.st_uid not in (0, os.geteuid()):
            raise UnsafePath("%s is a symbolic link owned by another user" % where)
        return None, os.readlink(name, dir_fd=parent_fd)
    try:
        fd = os.open(name, DIR_FLAGS, dir_fd=parent_fd)
    except OSError as err:
        if err.errno in (errno.ELOOP, errno.ENOTDIR):
            raise UnsafePath("%s changed while it was being opened" % where)
        raise
    try:
        held = os.fstat(fd)
        if (held.st_dev, held.st_ino) != (st.st_dev, st.st_ino):
            raise UnsafePath("%s changed while it was being opened" % where)
        _check_dir(held, where)
    except BaseException:
        os.close(fd)
        raise
    return fd, None


def open_dir(base, owned=(), create=False):
    """Hold `base`/`owned...` open and return it as a HeldDir.

    `base` (an XDG directory, or one below it) is walked from / one component
    at a time. Each directory must be owned by root or by you and writable by
    nobody else. A symlink along `base` is followed only if it is yours or
    root's, and then everything it leads through passes the same checks — so a
    dotfile manager's symlinked ~/.config keeps working while a link into
    someone else's directory does not.

    The `owned` components below it belong to this plugin: each must be a real
    directory (never a symlink) owned by you, and is tightened to 0700 when
    `create` is set. Missing components are created 0700 only with `create`;
    otherwise FileNotFoundError propagates."""
    if not isinstance(base, str) or not base.startswith("/") or "\x00" in base:
        raise UnsafePath("Not an absolute directory: %r" % (base,))
    stack = [os.open("/", DIR_FLAGS)]
    names = []
    try:
        _check_dir(os.fstat(stack[0]), "/")
        pending = [part for part in reversed(base.split("/")) if part]
        hops = 0
        while pending:
            name = pending.pop()
            if name == ".":
                continue
            if name == "..":
                if len(stack) > 1:
                    os.close(stack.pop())
                    names.pop()
                continue
            where = "/" + "/".join(names + [name])
            fd, target = _open_child(stack[-1], name, where, create)
            if target is not None:
                hops += 1
                if hops > MAX_SYMLINK_HOPS:
                    raise UnsafePath("Too many symbolic links under %s" % base)
                if target.startswith("/"):
                    while len(stack) > 1:
                        os.close(stack.pop())
                    names = []
                pending.extend(part for part in reversed(target.split("/")) if part)
                continue
            stack.append(fd)
            names.append(name)
        for name in owned:
            if not ENTRY_NAME_RE.match(name):
                raise UnsafePath("Bad directory name: %r" % (name,))
            where = "/" + "/".join(names + [name])
            fd, target = _open_child(stack[-1], name, where, create)
            if target is not None:
                raise UnsafePath("%s is a symbolic link" % where)
            stack.append(fd)
            names.append(name)
            st = os.fstat(fd)
            if st.st_uid != os.geteuid():
                raise UnsafePath("%s is not owned by you" % where)
            if create and st.st_mode & 0o077:
                os.fchmod(fd, 0o700)
        return HeldDir(stack.pop(), "/" + "/".join(names))
    finally:
        for fd in stack:
            os.close(fd)


def read_file_at(held, name, limit, private):
    """The bytes of regular file `name` below `held`, or None when there is no
    such entry. Refused with UnsafePath: a symlink (O_NOFOLLOW), a FIFO, socket
    or device (opened non-blocking so it cannot hang, then rejected by type), a
    file owned by someone else or with a second hard link, one others can write
    — or, when `private`, read — and anything larger than `limit` bytes, which
    is never read past limit + 1."""
    where = held.entry(name)
    if not ENTRY_NAME_RE.match(name):
        raise UnsafePath("Bad file name: %r" % (name,))
    try:
        fd = os.open(name, READ_FLAGS, dir_fd=held.fd)
    except FileNotFoundError:
        return None
    except OSError as err:
        if err.errno == errno.ELOOP:
            raise UnsafePath("%s is a symbolic link" % where)
        raise
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise UnsafePath("%s is not a regular file" % where)
        if st.st_uid != os.geteuid():
            raise UnsafePath("%s is not owned by you" % where)
        if st.st_nlink != 1:
            raise UnsafePath("%s has more than one hard link" % where)
        if st.st_mode & (0o077 if private else 0o022):
            raise UnsafePath("%s is open to other users (mode %o) — chmod 600 it"
                             % (where, stat.S_IMODE(st.st_mode)))
        if st.st_size > limit:
            raise UnsafePath("%s is larger than %d bytes" % (where, limit))
        chunks = []
        total = 0
        while total <= limit:
            chunk = os.read(fd, min(65536, limit + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > limit:
            raise UnsafePath("%s is larger than %d bytes" % (where, limit))
        return b"".join(chunks)
    finally:
        os.close(fd)


def write_file_at(held, name, data, mode=0o600, sync=True):
    """Atomically replace `name` below `held` with `data`.

    The content goes into a fresh, unpredictably named temp file created with
    O_CREAT|O_EXCL|O_NOFOLLOW at 0600 — so nothing planted in advance can be
    written through — then fsynced and renamed over `name` within the same held
    directory. rename(2) replaces a directory entry and never follows one. An
    existing `name` that is not a regular file you own (a symlink, a FIFO,
    someone else's file) is refused rather than replaced. The temp file is
    removed on any failure."""
    where = held.entry(name)
    if not ENTRY_NAME_RE.match(name):
        raise UnsafePath("Bad file name: %r" % (name,))
    try:
        st = os.stat(name, dir_fd=held.fd, follow_symlinks=False)
    except FileNotFoundError:
        st = None
    if st is not None and (not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid()):
        raise UnsafePath("Refusing to replace %s: it is not a regular file you own" % where)
    tmp = ".%s.%s.tmp" % (name, secrets.token_hex(12))
    fd = os.open(tmp, CREATE_FLAGS, 0o600, dir_fd=held.fd)
    try:
        try:
            os.fchmod(fd, mode)
            view = memoryview(data)
            while view:
                view = view[os.write(fd, view):]
            if sync:
                os.fsync(fd)
        finally:
            os.close(fd)
        os.rename(tmp, name, src_dir_fd=held.fd, dst_dir_fd=held.fd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=held.fd)
        except OSError:
            pass
        raise
    if not sync:
        return  # (still written whole: the rename replaces the old file at once)
    try:
        os.fsync(held.fd)
    except OSError:
        pass


def unlink_at(held, name):
    """Remove the entry itself (a symlink is removed, never followed)."""
    try:
        os.unlink(name, dir_fd=held.fd)
        return True
    except OSError:
        return False


def lexists_at(held, name):
    try:
        os.stat(name, dir_fd=held.fd, follow_symlinks=False)
        return True
    except OSError:
        return False



# ------------------------------------------------------------------ http core

class ResponseTooLarge(ApiError):
    def __init__(self, limit):
        super().__init__("too_large", "Pocket Casts sent a reply larger than %d bytes; it was refused" % limit)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Never follow a redirect automatically: following one would copy the
    bearer token onto the new request and read the redirect body without a
    limit. The one place Pocket Casts redirects (a show's episode list) is
    followed by hand, host-checked and without the token."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def build_opener(allow_plain_http=False):
    """An opener with HTTPS and nothing else: no proxies taken from the
    environment, no redirects, no file:, ftp: or data: handlers."""
    opener = urllib.request.OpenerDirector()
    handlers = [
        urllib.request.UnknownHandler(),
        urllib.request.HTTPDefaultErrorHandler(),
        NoRedirect(),
        urllib.request.HTTPErrorProcessor(),
        urllib.request.HTTPSHandler(context=ssl.create_default_context()),
    ]
    if allow_plain_http:  # the test suite's local server only
        handlers.append(urllib.request.HTTPHandler())
    for handler in handlers:
        opener.add_handler(handler)
    return opener


_OPENER = None
_OPENER_LOCK = threading.Lock()


def opener():
    global _OPENER
    with _OPENER_LOCK:
        if _OPENER is None:
            _OPENER = build_opener()
        return _OPENER


def read_bounded(stream, limit, headers=None, deadline=None):
    """A whole HTTP body, but never more than `limit` bytes: refused up front
    when Content-Length already exceeds it, otherwise read in chunks and
    abandoned at the first byte past it. `deadline` (time.monotonic) bounds
    the whole read, so a server trickling bytes under the socket timeout still
    cannot hold the bridge open."""
    length = headers.get("Content-Length") if headers is not None else None
    if length is not None:
        try:
            declared = int(str(length).strip())
        except ValueError:
            declared = -1
        if declared > limit:
            raise ResponseTooLarge(limit)
    read = getattr(stream, "read1", None) or stream.read
    chunks = []
    total = 0
    while True:
        if deadline is not None and time.monotonic() > deadline:
            raise ApiError("network", "Pocket Casts took too long to answer")
        chunk = read(min(65536, limit + 1 - total))
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
        if total > limit:
            raise ResponseTooLarge(limit)
    return b"".join(chunks)


def http_raw(method, url, headers=None, data=None, timeout=None, limit=API_MAX_BYTES):
    """Return (status, body_bytes, headers). Never raises for HTTP status codes;
    raises ApiError for transport failures and for any body — success or error
    — over its cap. The timeout is read when called, not when defined, so the
    sleep guard's shorter one (HTTP_TIMEOUT set at run time) applies."""
    timeout = HTTP_TIMEOUT if timeout is None else timeout
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("User-Agent", USER_AGENT)
    for key, value in (headers or {}).items():
        req.add_header(key, value)
    deadline = time.monotonic() + 2 * timeout
    try:
        with opener().open(req, timeout=timeout) as resp:
            return resp.status, read_bounded(resp, limit, resp.headers, deadline), dict(resp.headers)
    except urllib.error.HTTPError as err:
        try:
            body = read_bounded(err, min(limit, ERROR_MAX_BYTES), err.headers, deadline)
        except (OSError, http_client.HTTPException):
            body = b""
        finally:
            err.close()
        return err.code, body, dict(err.headers or {})
    except urllib.error.URLError as err:
        raise ApiError("network", "Pocket Casts is unreachable: %s" % getattr(err, "reason", err))
    except (TimeoutError, OSError, http_client.HTTPException) as err:
        raise ApiError("network", "Pocket Casts request failed (%s)" % err)


@contextlib.contextmanager
def http_timeout(seconds):
    """Requests made inside wait at most `seconds` (HTTP_TIMEOUT, lowered for
    the moment; http_raw reads it when called)."""
    global HTTP_TIMEOUT
    saved = HTTP_TIMEOUT
    HTTP_TIMEOUT = min(saved, seconds)
    try:
        yield
    finally:
        HTTP_TIMEOUT = saved


def http(method, url, headers=None, data=None, timeout=None, limit=API_MAX_BYTES):
    """Return (status, body_text, headers); see http_raw."""
    status, body, resp_headers = http_raw(method, url, headers, data, timeout, limit)
    return status, body.decode("utf-8", "replace"), resp_headers



# ----------------------------------------------------------------- state store

def state_dir(create=False):
    return open_dir(xdg_home("XDG_STATE_HOME", ".local", "state"), ("omarchy-legato",), create)


def load_json_at(held, name, limit, private):
    blob = read_file_at(held, name, limit, private)
    if not blob:
        return {}
    try:
        data = json.loads(blob.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def load_state(name, limit=STATE_MAX_BYTES):
    """A private JSON file from the state directory, or {} when there is none.
    One that is a symlink, not yours, open to other users, hard-linked or
    oversized raises UnsafePath: it is neither read nor silently ignored."""
    try:
        with state_dir() as held:
            return load_json_at(held, name, limit, private=True)
    except FileNotFoundError:
        return {}


def save_state(name, data, sync=True):
    blob = json.dumps(data, ensure_ascii=False).encode("utf-8")
    with state_dir(create=True) as held:
        write_file_at(held, name, blob, 0o600, sync)


def drop_state(name):
    try:
        with state_dir() as held:
            unlink_at(held, name)
    except FileNotFoundError:
        pass


def load_auth():
    return load_state("auth.json", AUTH_MAX_BYTES)


def save_auth(auth):
    save_state("auth.json", auth)


def clear_auth():
    drop_state("auth.json")


# Sign-in, sign-out and every token write hold the auth lock, and a write to
# an existing session first checks the session on disk is still that one
# (the same refresh token): an older call's refresh or "expired" flag never
# writes back an account you've signed out of (or out of and into again),
# and two calls refreshing at once share one refresh. Innermost: taken
# inside the state or prefs lock, never around them. (Marketplace review,
# #15655.)
AUTH_LOCK_TIMEOUT = 40  # a refresh holds it across one token request


def auth_lock():
    return StateLock(timeout=AUTH_LOCK_TIMEOUT, name="auth.lock")


def same_session(a, b):
    return bool(a) and bool(b) and a.get("refresh_token") == b.get("refresh_token")


def mark_needs_reauth(auth):
    """Flag the session expired, if it's still the one on disk; then raise."""
    with auth_lock():
        current = load_auth()
        if same_session(current, auth):
            current["needs_reauth"] = True
            save_auth(current)
    auth["needs_reauth"] = True
    raise ApiError("reauth", "Pocket Casts session expired — sign in again")


class StateLock:
    """An exclusive flock on the state directory's lock file, so a player poll
    and a click never both decide what plays next. `name` picks another lock
    file in the same directory (prefs.json has its own, `prefs_update`)."""

    def __init__(self, timeout=10.0, name="lock"):
        self.timeout = timeout
        self.name = name
        self.fd = -1

    def __enter__(self):
        with state_dir(create=True) as held:
            self.fd = os.open(self.name, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=held.fd)
        st = os.fstat(self.fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid():
            os.close(self.fd)
            raise UnsafePath("The lock file is not a regular file you own")
        deadline = time.monotonic() + self.timeout
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if time.monotonic() > deadline:
                    os.close(self.fd)
                    raise ApiError("busy", "Another Pocket Casts action is still running")
                time.sleep(0.05)

    def __exit__(self, *exc):
        if self.fd >= 0:
            os.close(self.fd)
            self.fd = -1


# ------------------------------------------------------------------ pocket casts

def url_host_is(url, hosts):
    try:
        parts = urllib.parse.urlsplit(str(url or ""))
        port = parts.port
    except ValueError:
        return False
    return (parts.scheme == "https" and not parts.username and not parts.password
            and port in (None, 443) and (parts.hostname or "") in hosts)


def gunzip_bounded(blob, limit):
    """Decompress a gzip body without ever holding more than `limit` bytes."""
    inflater = zlib.decompressobj(16 + zlib.MAX_WBITS)
    try:
        data = inflater.decompress(blob, limit + 1)
    except zlib.error:
        raise ApiError("bad_response", "Pocket Casts sent a corrupt compressed reply")
    if len(data) > limit or inflater.unconsumed_tail:
        raise ResponseTooLarge(limit)
    return data


def decode_body(blob, headers):
    encoding = ""
    for key, value in (headers or {}).items():
        if key.lower() == "content-encoding":
            encoding = str(value).lower().strip()
    if encoding == "gzip" or blob[:2] == b"\x1f\x8b":
        return gunzip_bounded(blob, SHOW_MAX_BYTES)
    return blob


def parse_json(blob, what="Pocket Casts"):
    try:
        return json.loads(blob.decode("utf-8")) if blob else {}
    except (UnicodeDecodeError, ValueError):
        raise ApiError("bad_response", "%s sent something that is not JSON" % what)


def error_text(payload, status):
    if isinstance(payload, dict):
        for key in ("errorMessage", "message", "error_description", "error"):
            if isinstance(payload.get(key), str) and payload[key].strip():
                return payload[key].strip()[:200]
    return "Pocket Casts request failed (HTTP %d)" % status


def post_json(path, body, token="", timeout=None):
    """POST a JSON body to the API. Returns (status, payload)."""
    headers = {"Content-Type": "application/json", "Accept": "application/json",
               "Accept-Encoding": "gzip"}
    if token:
        headers["Authorization"] = "Bearer " + token
    data = json.dumps(body if body is not None else {}).encode("utf-8")
    status, blob, resp_headers = http_raw("POST", API + path, headers, data, timeout)
    blob = decode_body(blob, resp_headers)
    try:
        payload = json.loads(blob.decode("utf-8")) if blob else {}
    except (UnicodeDecodeError, ValueError):
        payload = {}
    return status, payload


def store_tokens(auth, payload):
    auth["access_token"] = str(payload.get("accessToken") or "")
    if payload.get("refreshToken"):
        auth["refresh_token"] = str(payload["refreshToken"])
    auth["expires_at"] = time.time() + float(payload.get("expiresIn") or 3600)
    if payload.get("email"):
        auth["email"] = str(payload["email"])[:256]
    if payload.get("uuid"):
        auth["uuid"] = str(payload["uuid"])[:64]
    auth.pop("needs_reauth", None)
    save_auth(auth)


def refresh_tokens(auth):
    """New tokens for `auth`'s session, under the auth lock and from what's on
    disk now. Signed out meanwhile: nothing is written. Signed into another
    account meanwhile: this call stops. Refreshed by another call meanwhile:
    its tokens are used, with no second refresh."""
    with auth_lock():
        current = load_auth()
        if not current:
            raise ApiError("signed_out", "Not signed in to Pocket Casts")
        if auth.get("uuid") and current.get("uuid") and current["uuid"] != auth["uuid"]:
            raise ApiError("signed_out", "Signed in to another Pocket Casts account meanwhile")
        if current.get("needs_reauth"):
            auth.clear()
            auth.update(current)
            raise ApiError("reauth", "Pocket Casts session expired — sign in again")
        if current.get("access_token") != auth.get("access_token") \
                and time.time() < float(current.get("expires_at", 0)) - 60:
            auth.clear()
            auth.update(current)
            return current["access_token"]  # another call refreshed it
        auth.clear()
        auth.update(current)  # refresh the session as it is on disk now
        # The call's deadline waits until the answer is stored: one landing
        # between Pocket Casts' answer and the write would lose a rotated
        # refresh token. TOKEN_TIMEOUT bounds the wait.
        with deadline_held():
            status, payload = post_json("/user/token", {"grantType": "refresh_token",
                                                        "refreshToken": auth.get("refresh_token", "")},
                                        timeout=TOKEN_TIMEOUT)
            if status == 200 and payload.get("accessToken"):
                store_tokens(auth, payload)  # still the session on disk: checked above, under the lock
                return auth["access_token"]
        if status in (400, 401, 403):
            auth["needs_reauth"] = True
            save_auth(auth)
            raise ApiError("reauth", "Pocket Casts session expired — sign in again")
    raise ApiError("network", error_text(payload, status), status)


def access_token(auth, force_refresh=False):
    if not auth.get("refresh_token") and not auth.get("access_token"):
        raise ApiError("signed_out", "Not signed in to Pocket Casts")
    if auth.get("needs_reauth"):
        raise ApiError("reauth", "Pocket Casts session expired — sign in again")
    if not force_refresh and auth.get("access_token") and time.time() < float(auth.get("expires_at", 0)) - 60:
        return auth["access_token"]
    if not auth.get("refresh_token"):
        mark_needs_reauth(auth)
    if not REFRESH_ALLOWED:
        # Before sleep (pause_for_sleep): a refresh cut short by its 4 s limit
        # after Pocket Casts rotated the refresh token would sign you out, and
        # the auth lock another call holds could keep the push past the sleep.
        # The push waits; the next resume asks Pocket Casts (rule 2).
        raise ApiError("network", "No sign-in refresh just before sleep")
    return refresh_tokens(auth)


_AUTH = None


def api(path, body=None):
    """An authenticated API call. Retries once with fresh tokens on a 401."""
    global _AUTH
    if _AUTH is None:
        _AUTH = load_auth()
    token = access_token(_AUTH)
    status, payload = post_json(path, body, token)
    if status == 401:
        token = access_token(_AUTH, force_refresh=True)
        status, payload = post_json(path, body, token)
        if status == 401:
            mark_needs_reauth(_AUTH)
    if status == 429:
        raise ApiError("rate_limited", "Pocket Casts asked us to slow down", status, 30)
    if status >= 400:
        raise ApiError("api", error_text(payload, status), status)
    return payload if isinstance(payload, dict) else {}


def fetch_show(podcast_uuid):
    """The public episode list for a show. The API answers with a redirect to
    a gzipped file on Pocket Casts' CDN; up to three hops are followed, each
    only to an https Pocket Casts host and never with the bearer token."""
    url = "%s/podcast/full/%s" % (PODCAST_API, safe_uuid(podcast_uuid))
    for _ in range(4):
        if not url_host_is(url, SHOW_HOSTS):
            raise ApiError("bad_response", "Pocket Casts redirected somewhere unexpected")
        status, blob, headers = http_raw("GET", url, {"Accept": "application/json", "Accept-Encoding": "gzip"},
                                         limit=SHOW_MAX_BYTES)
        if status in (301, 302, 303, 307, 308):
            location = ""
            for key, value in headers.items():
                if key.lower() == "location":
                    location = str(value)
            url = urllib.parse.urljoin(url, location)
            continue
        if status == 404:
            raise ApiError("not_found", "Pocket Casts has no episode list for that show")
        if status != 200:
            raise ApiError("api", "Pocket Casts could not list that show's episodes (HTTP %d)" % status, status)
        data = parse_json(decode_body(blob, headers))
        podcast = data.get("podcast") if isinstance(data, dict) else None
        if not isinstance(podcast, dict):
            raise ApiError("bad_response", "Pocket Casts sent an episode list without a show")
        return podcast
    raise ApiError("bad_response", "Pocket Casts redirected too many times")


# ------------------------------------------------------------------ artwork

def podcast_art(podcast_uuid):
    if not podcast_uuid or not UUID_RE.match(str(podcast_uuid)):
        return ""
    return "%s/%d/%s.jpg" % (ART_BASE, ART_SIZE, str(podcast_uuid).lower())


def art_url_allowed(url):
    """HTTPS to Pocket Casts' artwork host on the default port, no credentials."""
    try:
        parts = urllib.parse.urlsplit(str(url or ""))
        port = parts.port
    except ValueError:
        return False
    return (parts.scheme == "https" and not parts.username and not parts.password
            and port in (None, 443) and bool(ART_HOST_RE.match(parts.hostname or "")))


_ART_DIR = None
_ART_DIR_LOCK = threading.Lock()


def art_dir():
    """The cover cache, held open for the life of the process so the download
    workers all write relative to one checked descriptor."""
    global _ART_DIR
    with _ART_DIR_LOCK:
        if _ART_DIR is None:
            _ART_DIR = open_dir(xdg_home("XDG_CACHE_HOME", ".cache"), ("omarchy-legato", "art"), create=True)
        return _ART_DIR


def looks_like_image(blob):
    """JPEG, PNG or WebP by their first bytes: nothing else is kept as art."""
    blob = blob or b""
    return (blob.startswith(b"\xff\xd8\xff") or blob.startswith(b"\x89PNG\r\n\x1a\n")
            or (blob[:4] == b"RIFF" and blob[8:12] == b"WEBP"))


def cache_one(url):
    if not art_url_allowed(url):
        return ""
    name = hashlib.sha1(url.encode("utf-8")).hexdigest()[:28] + ".jpg"
    try:
        held = art_dir()
        try:
            st = os.stat(name, dir_fd=held.fd, follow_symlinks=False)
        except FileNotFoundError:
            st = None
        if st is not None:
            if (stat.S_ISREG(st.st_mode) and st.st_uid == os.geteuid() and st.st_nlink == 1
                    and not st.st_mode & 0o022 and 0 < st.st_size <= ART_MAX_BYTES):
                return held.entry(name)
            # Anything else under that name — a symlink, a FIFO, somebody
            # else's file — is taken out and the cover fetched again.
            unlink_at(held, name)
        status, blob, _ = http_raw("GET", url, timeout=ART_TIMEOUT, limit=ART_MAX_BYTES)
        if status != 200 or not looks_like_image(blob):
            return ""
        write_file_at(held, name, blob, 0o600)
        return held.entry(name)
    except Exception:
        return ""


def cache_art(items):
    """Fill `artPath` on every dict in `items` (recursing one level into `items`
    lists) by downloading their `art` URLs concurrently."""
    targets = []

    def collect(obj):
        if isinstance(obj, dict):
            if obj.get("art") and not obj.get("artPath"):
                targets.append(obj)
            for value in obj.values():
                if isinstance(value, (list, dict)):
                    collect(value)
        elif isinstance(obj, list):
            for value in obj:
                collect(value)

    collect(items)
    if not targets:
        return items
    urls = sorted({t["art"] for t in targets})
    with ThreadPoolExecutor(max_workers=ART_WORKERS) as pool:
        paths = dict(zip(urls, pool.map(cache_one, urls)))
    for target in targets:
        target["artPath"] = paths.get(target["art"], "")
    return items




# -------------------------------------------------------------- normalizers

def as_int(value):
    try:
        return max(0, int(float(value or 0)))
    except (TypeError, ValueError):
        return 0


def text(value, limit=300):
    s = " ".join(str(value or "").split())
    return s if len(s) <= limit else s[: limit - 1].rstrip() + "…"


def norm_episode(e, podcast_uuid="", podcast_title="", sync=None):
    """One episode in the shape every list and the player share. Times are in
    whole seconds; `status` is Pocket Casts' playingStatus (1 unplayed,
    2 in progress, 3 played)."""
    if not isinstance(e, dict):
        return None
    uuid = str(e.get("uuid") or "").lower()
    if not UUID_RE.match(uuid):
        return None
    sync = sync if isinstance(sync, dict) else {}
    podcast = str(e.get("podcastUuid") or e.get("podcast") or podcast_uuid or "").lower()
    if not UUID_RE.match(podcast):
        podcast = ""
    duration = as_int(e.get("duration")) or as_int(sync.get("duration"))
    played = as_int(e.get("playedUpTo")) or as_int(sync.get("playedUpTo"))
    status = as_int(e.get("playingStatus")) or as_int(sync.get("playingStatus"))
    if status == 0:
        status = STATUS_IN_PROGRESS if played > 0 else STATUS_UNPLAYED
    return {
        "type": "episode",
        "uuid": uuid,
        "podcast": podcast,
        "show": text(e.get("podcastTitle") or podcast_title, 200),
        "name": text(e.get("title"), 300) or "Untitled episode",
        "url": safe_media_url(e.get("url")),
        "published": str(e.get("published") or "")[:32],
        "duration": duration,
        "playedUpTo": played,
        "status": status,
        "starred": e.get("starred") is True,
        "art": podcast_art(podcast),
    }


def show_seconds(p, key):
    """A show's skip-intro (autoStartFrom) or skip-outro (autoSkipLast) in
    seconds, set in any Pocket Casts app; it comes both at the top level
    and inside `settings`."""
    value = p.get(key)
    if value is None:
        setting = (p.get("settings") or {}).get(key) if isinstance(p.get("settings"), dict) else None
        value = setting.get("value") if isinstance(setting, dict) else None
    return min(as_int(value), 3600)


def norm_podcast(p):
    if not isinstance(p, dict):
        return None
    uuid = str(p.get("uuid") or "").lower()
    if not UUID_RE.match(uuid):
        return None
    return {
        "type": "podcast",
        "uuid": uuid,
        "name": text(p.get("title"), 200) or "Untitled show",
        "author": text(p.get("author"), 200),
        "lastPublished": str(p.get("lastEpisodePublished") or "")[:32],
        "unplayed": p.get("unplayed") is True,
        "art": podcast_art(uuid),
        "startFrom": show_seconds(p, "autoStartFrom"),
        "skipLast": show_seconds(p, "autoSkipLast"),
    }


# ---------------------------------------------------------------- library

PODCASTS_CACHE_SECONDS = 600


def subscriptions(force=False):
    """Your shows, newest episode first. Kept for ten minutes in the state
    directory so Up Next and the player can name an episode's show."""
    cached = {} if force else load_state("podcasts-cache.json", 4 * 1024 * 1024)
    if cached and time.time() - float(cached.get("at") or 0) < PODCASTS_CACHE_SECONDS and isinstance(cached.get("items"), list):
        return cached["items"]
    payload = api("/user/podcast/list", {"v": 1})
    items = [p for p in (norm_podcast(x) for x in payload.get("podcasts") or []) if p]
    items.sort(key=lambda p: p.get("lastPublished") or "", reverse=True)
    try:
        save_state("podcasts-cache.json", {"at": time.time(), "items": items})
    except (OSError, ApiError):
        pass
    return items


def podcast_titles():
    try:
        return {p["uuid"]: p["name"] for p in subscriptions()}
    except ApiError:
        return {}


def up_next_raw():
    payload = api("/up_next/list", {"version": 2, "model": "webplayer", "serverModified": 0, "showPlayStatus": True})
    sync = {}
    for s in payload.get("episodeSync") or []:
        if isinstance(s, dict) and s.get("uuid"):
            sync[str(s["uuid"]).lower()] = s
    return payload.get("episodes") or [], sync


def up_next_items():
    episodes, sync = up_next_raw()
    titles = podcast_titles()
    items = []
    for e in episodes:
        item = norm_episode(e, sync=sync.get(str((e or {}).get("uuid") or "").lower()))
        if item:
            item["show"] = item["show"] or titles.get(item["podcast"], "")
            items.append(item)
    return items


def user_episode(uuid):
    """Everything Pocket Casts knows about one episode, including your
    position in it; {} when it has no record (some shows you never followed)."""
    try:
        payload = api("/user/episode", {"uuid": safe_uuid(uuid)})
    except ApiError as err:
        if err.status == 404 or err.code == "bad_response":
            return {}
        raise
    return payload if payload.get("uuid") else {}


def resolve_episode(uuid, podcast_uuid=""):
    """An episode with a playable URL: from your Pocket Casts record, or —
    for a show you don't follow — from the show's public episode list."""
    uuid = safe_uuid(uuid)
    raw = user_episode(uuid)
    item = norm_episode(raw) if raw else None
    if item and item["url"]:
        if not item["show"] and item["podcast"]:
            item["show"] = podcast_titles().get(item["podcast"], "")
        return item
    podcast_uuid = (item or {}).get("podcast") or podcast_uuid
    if not podcast_uuid:
        raise ApiError("not_found", "Pocket Casts has no audio for that episode")
    show = fetch_show(podcast_uuid)
    for e in show.get("episodes") or []:
        if str((e or {}).get("uuid") or "").lower() == uuid:
            found = norm_episode(e, podcast_uuid, show.get("title"))
            if found and found["url"]:
                if item:
                    found["playedUpTo"] = item["playedUpTo"]
                    found["status"] = item["status"]
                    found["duration"] = item["duration"] or found["duration"]
                return found
    raise ApiError("not_found", "Pocket Casts has no audio for that episode")


def push_position(item, position, status=STATUS_IN_PROGRESS):
    """Tell Pocket Casts where you are in an episode."""
    if not item or not item.get("uuid") or not item.get("podcast"):
        return False
    body = {"uuid": item["uuid"], "podcast": item["podcast"], "position": int(max(0, position)), "status": status}
    if item.get("duration"):
        body["duration"] = int(item["duration"])
    api("/sync/update_episode", body)
    return True


def up_next_episode_body(item):
    return {"uuid": item["uuid"], "title": item.get("name", ""), "url": item.get("url", ""),
            "podcast": item.get("podcast", ""), "published": item.get("published", "")}


def up_next_put(item, where):
    """Queue an episode: "now" (top of Up Next, where Pocket Casts keeps what
    is playing), "next" or "last". Pocket Casts' web player uses play_now for
    the first; if the server refuses it, play_next is the closest stand-in.
    True when the episode went where it was asked to."""
    endpoint = {"now": "/up_next/play_now", "next": "/up_next/play_next", "last": "/up_next/play_last"}[where]
    body = {"version": 2, "episode": up_next_episode_body(item)}
    try:
        api(endpoint, body)
    except ApiError as err:
        if where == "now" and err.status in (400, 404, 405):
            api("/up_next/play_next", body)
            return False
        raise
    return True


def up_next_top():
    """The episode at the top of Up Next (where Pocket Casts keeps the one
    playing on whichever device played last), or None when it is empty."""
    episodes, sync = up_next_raw()
    for e in episodes:
        uuid = str((e or {}).get("uuid") or "").lower()
        item = norm_episode(e, sync=sync.get(uuid))
        if item:
            return item
    return None


def up_next_remove(uuids):
    uuids = [safe_uuid(u) for u in uuids if u]
    if uuids:
        api("/up_next/remove", {"version": 2, "uuids": uuids})


# ---------------------------------------------------------------------- mpv

MPV_PROPERTIES = ("path", "pause", "time-pos", "duration", "volume", "speed", "eof-reached", "vid", "track-list", "af",
                  "idle-active", "paused-for-cache", "playlist-count", "stream-end", "user-data/legato")
END_PROPERTIES = ("stream-pos", "stream-end", "file-local-options/end", "seekable", "file-format")


def runtime_dir(create=False):
    base = clean_env_value("XDG_RUNTIME_DIR", os.environ.get("XDG_RUNTIME_DIR")) or "/run/user/%d" % os.geteuid()
    return open_dir(base, ("omarchy-legato",), create)


def socket_path(create=False):
    with runtime_dir(create) as held:
        return held.entry("mpv.sock")


def player_socket():
    """mpv's socket path for the panel to listen on, or "" when the runtime
    directory is unusable."""
    try:
        return socket_path(create=True)
    except (OSError, ApiError):
        return ""


def watch_script():
    """Legato's stream watcher (bin/legato-watch.lua, next to this file), so
    stream_broke has evidence of a break. Loaded only if it and every folder
    above it belong to this user or root and nobody else can write them."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "legato-watch.lua")
    try:
        if not stat.S_ISREG(os.lstat(path).st_mode):
            return ""
    except OSError:
        return ""
    return path if safe_chain(path, (0, os.geteuid())) else ""


def mpris_script():
    """mpv-mpris, when installed, so media keys and playerctl see the player.
    Only a root-owned copy in the system library directory is loaded."""
    for candidate in ("/usr/lib/mpv-mpris/mpris.so", "/usr/lib/mpv/mpris.so"):
        try:
            st = os.stat(candidate)
        except OSError:
            continue
        if stat.S_ISREG(st.st_mode) and safe_chain(os.path.realpath(candidate), (0,)):
            return os.path.realpath(candidate)
    return ""


class Mpv:
    """A connection to the plugin's mpv over its JSON IPC socket."""

    def __init__(self, sock):
        self.sock = sock
        self.buffer = b""
        self.next_id = 1
        self.dead = False  # stopped answering: every later command fails at once

    @classmethod
    def connect(cls, timeout=2.0):
        """The running player, or None when there isn't one. The socket must be
        a socket you own inside the plugin's private runtime directory."""
        try:
            path = socket_path()
        except FileNotFoundError:
            return None
        try:
            st = os.lstat(path)
        except OSError:
            return None
        if not stat.S_ISSOCK(st.st_mode) or st.st_uid != os.geteuid():
            return None
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        try:
            sock.connect(path)
        except OSError:
            sock.close()
            return None
        return cls(sock)

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()

    def command(self, *args, timeout=3):
        """Run one mpv command; returns its data, or raises ApiError."""
        if self.dead:
            raise ApiError("player_hung", "The player isn't answering")
        request_id = self.next_id
        self.next_id += 1
        line = json.dumps({"command": list(args), "request_id": request_id}) + "\n"
        try:
            self.sock.settimeout(timeout)
            self.sock.sendall(line.encode("utf-8"))
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline:
                while b"\n" in self.buffer:
                    raw, self.buffer = self.buffer.split(b"\n", 1)
                    try:
                        reply = json.loads(raw.decode("utf-8", "replace"))
                    except ValueError:
                        continue
                    if not isinstance(reply, dict) or reply.get("request_id") != request_id:
                        continue  # an event, or an answer to someone else
                    if reply.get("error") not in (None, "success"):
                        raise ApiError("player", "mpv: %s" % reply.get("error"))
                    return reply.get("data")
                # This command's own deadline, not the socket's connect-time
                # timeout (2 s), which would cut off a slow `vid auto`.
                self.sock.settimeout(max(0.05, deadline - time.monotonic()))
                chunk = self.sock.recv(65536)
                if not chunk:
                    break
                if len(self.buffer) > 1024 * 1024:
                    raise ApiError("player", "mpv sent too much at once")
                self.buffer += chunk
        except (OSError, socket.timeout) as err:
            self.dead = True
            raise ApiError("player", "Lost the connection to mpv (%s)" % err)
        self.dead = True
        raise ApiError("player_hung", "mpv did not answer")

    def responsive(self, timeout=2.0):
        """True when mpv answers a trivial question promptly."""
        try:
            self.sock.settimeout(timeout)
            self.command("get_property", "idle-active", timeout=timeout)
            return True
        except ApiError:
            return False
        finally:
            if not self.dead:
                self.sock.settimeout(2.0)

    def peer_pid(self):
        """The process at the other end of the socket (the kernel says so)."""
        try:
            creds = self.sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
        except OSError:
            return 0, -1
        pid, uid, _ = struct.unpack("3i", creds)
        return pid, uid

    def wait_for_load(self, timeout=20.0):
        """After a loadfile: return once mpv says the file opened, raise if it
        says the file failed, and give up quietly (still loading a slow
        stream) after `timeout`."""
        deadline = time.monotonic() + timeout
        try:
            while time.monotonic() < deadline:
                while b"\n" in self.buffer:
                    raw, self.buffer = self.buffer.split(b"\n", 1)
                    try:
                        event = json.loads(raw.decode("utf-8", "replace"))
                    except ValueError:
                        continue
                    if not isinstance(event, dict):
                        continue
                    if event.get("event") == "file-loaded":
                        return True
                    if event.get("event") == "end-file" and event.get("reason") == "error":
                        detail = str(event.get("file_error") or "unknown error")[:120]
                        raise ApiError("playback_failed", "mpv could not play that episode (%s)" % detail)
                self.sock.settimeout(max(0.1, deadline - time.monotonic()))
                chunk = self.sock.recv(65536)
                if not chunk:
                    break
                if len(self.buffer) > 1024 * 1024:
                    self.buffer = b""
                self.buffer += chunk
        except (OSError, socket.timeout):
            pass
        return False

    def get(self, name, default=None):
        try:
            return self.command("get_property", name)
        except ApiError:
            return default

    def set(self, name, value):
        return self.command("set_property", name, value)

    def snapshot(self):
        snap = {name: self.get(name) for name in MPV_PROPERTIES}
        if snap.get("eof-reached") is True:
            # At an end: what stream_broke needs to tell a real end from a
            # broken stream.
            snap.update({name: self.get(name) for name in END_PROPERTIES})
        return snap


def trim_level(value):
    value = str(value or "off").lower()
    return value if value in TRIM_LEVELS else "off"


def trim_filter(level):
    """The mpv audio filter for a Trim Silence level, or "" for off.
    timestamp=copy keeps each frame's own time, so mpv's position stays in
    the episode's time across a cut (with the default, it would fall behind,
    and the position pushed to Pocket Casts would be wrong)."""
    values = TRIM_LEVELS[trim_level(level)]
    if not values:
        return ""
    longer, keep = values
    return ("lavfi=[silenceremove=stop_periods=-1:stop_duration=%g:stop_silence=%g:"
            "stop_threshold=-42dB:detection=peak:timestamp=copy]" % (longer, keep))


def apply_trim(player, level):
    """Swap the trim filter on a running player. It always goes first in the
    chain ("pre"), ahead of Volume Boost. It keeps working with the video
    window open: mpv drops frames to keep the picture with the sound, so the
    picture jumps where a pause was cut."""
    try:
        player.command("af", "remove", TRIM_LABEL)
    except ApiError:
        pass  # none to remove
    spec = trim_filter(level)
    if spec:
        player.command("af", "pre", "%s:%s" % (TRIM_LABEL, spec))


def apply_boost(player, on):
    """Swap Volume Boost on a running player; it goes last ("add")."""
    try:
        player.command("af", "remove", BOOST_LABEL)
    except ApiError:
        pass
    if on:
        player.command("af", "add", "%s:%s" % (BOOST_LABEL, BOOST_FILTER))


def audio_filters(prefs):
    """mpv's --af list for a new player: trim, then boost."""
    chain = []
    trim = trim_filter(prefs.get("trim"))
    if trim:
        chain.append("%s:%s" % (TRIM_LABEL, trim))
    if prefs.get("boost") is True:
        chain.append("%s:%s" % (BOOST_LABEL, BOOST_FILTER))
    return ",".join(chain)


def mpv_quote(value):
    """mpv's length-prefixed quoting for a key=value list entry, so a title
    holding commas or equals signs stays one value."""
    value = str(value)
    return "%%%d%%%s" % (len(value.encode("utf-8")), value)


def display_gpus(root="/sys/class/drm"):
    """PCI vendor ids of the GPUs present and of those driving a connected
    display, from sysfs: ({all}, {driving a display})."""
    present, driving = set(), set()
    try:
        names = os.listdir(root)
    except OSError:
        return present, driving
    for name in names:
        card = re.match(r"^(card\d+)(-.+)?$", name)
        if not card:
            continue
        try:
            with open(os.path.join(root, card.group(1), "device", "vendor")) as fh:
                vendor = fh.read().strip().lower()
        except OSError:
            continue
        present.add(vendor)
        if card.group(2):
            try:
                with open(os.path.join(root, name, "status")) as fh:
                    if fh.read().strip() == "connected":
                        driving.add(vendor)
            except OSError:
                pass
    return present, driving


NVIDIA = "0x10de"


def mpv_gpu_env(root="/sys/class/drm"):
    """Extra environment for mpv: when an NVIDIA GPU is present but no display
    runs on it (a laptop's render-only dGPU), hide it from Vulkan, so the
    video window renders on the GPU that shows it. On the dGPU it took 1.8 s
    to start, kept ~450 MB of driver mapped, kept the dGPU awake, and once
    deadlocked mpv's video output."""
    present, driving = display_gpus(root)
    if NVIDIA in present and driving and NVIDIA not in driving:
        return {"VK_LOADER_DRIVERS_DISABLE": "*nvidia*"}
    return {}


def start_mpv(prefs):
    """Start the player detached (it outlives this script and the shell) and
    wait for its socket. mpv runs with --no-config so nothing from ~/.config/mpv
    — scripts, ytdl hooks, profiles — is loaded into it: only Legato's own
    stream watcher and, when installed system-wide, mpv-mpris."""
    mpv = trusted_tool("mpv")
    if not mpv:
        raise ApiError("no_mpv", "mpv is not installed — run: omarchy pkg add mpv")
    path = socket_path(create=True)
    try:
        st = os.lstat(path)
        if stat.S_ISSOCK(st.st_mode) and st.st_uid == os.geteuid():
            os.unlink(path)  # a dead player's socket
    except OSError:
        pass
    argv = [mpv, "--no-config", "--idle=yes", "--no-video", "--no-terminal", "--keep-open=yes",
            "--ytdl=no", "--tls-verify=yes", "--input-ipc-server=" + path, "--title=Legato",
            # The video window, when shown: its own app id (for its placement
            # rule), decoded on the GPU where that's known to be safe.
            "--wayland-app-id=" + VIDEO_APP_ID, "--hwdec=auto-safe",
            # Just the picture: no on-screen controls, which would act on
            # the player behind Legato's back.
            "--osc=no",
            # Text (its menu, "Always on top: on") at full size; scaled to a
            # mini-player it came out about 6 px tall.
            "--osd-scale-by-window=no",
            # With Trim Silence the sound jumps ahead at every cut pause; let
            # the decoder skip frames too, so the picture catches up sooner.
            "--framedrop=decoder+vo",
            # mpv 0.41 reads the clipboard at start-up; a podcast player has
            # no use for it.
            "--clipboard-backends-clr",
            "--audio-client-name=legato", "--cache=yes", "--network-timeout=30",
            # Enough buffer for a podcast, without mpv's 150 MB default.
            "--demuxer-max-bytes=64MiB", "--demuxer-max-back-bytes=16MiB",
            "--user-agent=" + USER_AGENT,
            "--volume=%d" % max(0, min(100, as_int(prefs.get("volume", 100)) if "volume" in prefs else 100)),
            "--speed=%s" % clamp_speed(prefs.get("speed", 1.0))]
    filters = audio_filters(prefs)
    if filters:
        argv.append("--af=" + filters)
    argv.extend(MPV_EXTRA_ARGS)
    for script in (watch_script(), mpris_script()):
        if script:
            argv.append("--script=" + script)
    # Its own session, so it is nobody's child for long: the bridge exits right
    # after this and mpv is reparented. Standard streams go to /dev/null; every
    # other descriptor here is close-on-exec.
    env = child_env()
    gpu_env = mpv_gpu_env()
    env.update(gpu_env)
    if gpu_env:
        # The NVIDIA decoder would wake the dGPU too: decode on the display's GPU.
        argv = [a for a in argv if not a.startswith("--hwdec=")] + ["--hwdec=vulkan,vaapi"]
    devnull = os.open(os.devnull, os.O_RDWR | os.O_CLOEXEC)
    try:
        os.posix_spawn(mpv, argv, env, setsid=True,
                       file_actions=[(os.POSIX_SPAWN_DUP2, devnull, 0), (os.POSIX_SPAWN_DUP2, devnull, 1),
                                     (os.POSIX_SPAWN_DUP2, devnull, 2)])
    except OSError as err:
        raise ApiError("player", "Could not start mpv (%s)" % err)
    finally:
        os.close(devnull)
    deadline = time.monotonic() + 6
    while time.monotonic() < deadline:
        player = Mpv.connect(timeout=1.0)
        if player:
            bind_video_window_keys(player, prefs)
            return player
        time.sleep(0.1)
    raise ApiError("player", "mpv started but its control socket never appeared")


# ------------------------------------------------------------- video window
#
# Many podcasts are video. Legato plays audio only, until `video on` shows
# mpv's own window as a picture in picture: floating, pinned to every
# workspace, without taking focus, bottom-right above the bars (as Omarchy's
# webcam overlay does), or wherever it was last moved. The placement is a
# Hyprland window rule added at run time (`hyprctl repl`), because a plugin
# can't add config files; on a Hyprland without the Lua config the window
# opens wherever Hyprland's own rules put it.

VIDEO_APP_ID = "legato-video"
# The Hyprland tag on the video window, while it's pinned (Always on top),
# that asks taskbars and window switchers to leave it out (Transom and Latch
# honor it).
SKIP_TASKBAR_TAG = "skip-taskbar"
GEOMETRY_RE = re.compile(r"^-?\d{1,5}$")
# How see-through the video window is, in percent. Capped below 100: a
# window you can't see is one you can't find to right-click.
TRANSPARENCY_LEVELS = (0, 10, 20, 30, 40, 50, 60, 70, 80)


# The video window's keys: Legato's own (the panel's), sent to the service
# as `legato-key <action>` (Service.qml's videoKey), so they act exactly as
# in the panel: a resume still asks Pocket Casts first. mpv's built-in keys
# (and those its scripts add, like stats on `i`) are off in the window: a
# stray `[` or `m` would change speed or mute behind Legato's back.
VIDEO_WINDOW_KEYS = (
    # Closing the window, or q inside it, hides the video; quitting the
    # player would stop the episode.
    ("CLOSE_WIN", "set vid no"), ("q", "set vid no"), ("Q", "set vid no"),
    # Right-click: mpv's menu on Linux is its context_menu script (the
    # `context-menu` command only opens the native menus of Windows and
    # macOS, and does nothing here).
    ("MBTN_RIGHT", "script-message-to context_menu open"),
    ("SPACE", "playPause"),
    ("f", "skipForward"), (".", "skipForward"), ("RIGHT", "skipForward"),
    ("b", "skipBack"), (",", "skipBack"), ("LEFT", "skipBack"),
    ("n", "next"), ("s", "stop"), ("p", "cycleSpeed"), ("t", "cycleTrim"),
    ("o", "toggleBoost"), ("v", "toggleVideo"),
    ("+", "volumeUp"), ("=", "volumeUp"), ("UP", "volumeUp"), ("WHEEL_UP", "volumeUp"),
    ("-", "volumeDown"), ("DOWN", "volumeDown"), ("WHEEL_DOWN", "volumeDown"),
)
VIDEO_KEY_ACTIONS = frozenset(cmd for _, cmd in VIDEO_WINDOW_KEYS if " " not in cmd)


def bind_video_window_keys(player, prefs=None):
    """The video window's keys (VIDEO_WINDOW_KEYS) and right-click menu."""
    try:
        # Off at run time too, for a player that's already up: weak
        # bindings, which are mpv's built-ins and its scripts' keys. The
        # context menu's own keys while open are forced ones and stay.
        player.command("set_property", "input-default-bindings", False)
    except ApiError:
        pass
    for key, cmd in VIDEO_WINDOW_KEYS:
        try:
            player.command("keybind", key, cmd if " " in cmd else "script-message legato-key " + cmd)
        except ApiError:
            pass
    try:
        player.command("set_property", "menu-data", video_menu(prefs or load_prefs()))
    except ApiError:
        pass


def osd(player, text):
    """A brief message on the video window; an audio-only player has no
    window, so nothing shows."""
    try:
        player.command("show-text", text, 1500)
    except ApiError:
        pass


# Picture formats: a "video" stream in one of these is a single still (a
# cover packed into the file as a video stream, which mpv doesn't flag as
# cover art: seen 2026-11-21, a PNG in an episode's MP4), not a video.
STILL_IMAGE_CODECS = frozenset(("png", "mjpeg", "jpeg", "bmp", "gif", "webp", "tiff", "jpeg2000", "jpegxl", "qoi"))


def has_video(snap):
    """A real video track. An episode's cover art shows up as one too,
    flagged (albumart, image) or not (a still-picture codec)."""
    tracks = snap.get("track-list") if isinstance(snap.get("track-list"), list) else []
    return any(isinstance(t, dict) and t.get("type") == "video" and not t.get("albumart") and not t.get("image")
               and str(t.get("codec") or "").lower() not in STILL_IMAGE_CODECS for t in tracks)


def video_shown(snap):
    return snap.get("vid") not in (None, False, "no")


def hyprctl(*args):
    """Run hyprctl with the bridge's closed environment; "" on any failure."""
    tool = trusted_tool("hyprctl")
    if not tool:
        return ""
    try:
        done = subprocess.run([tool] + list(args), env=child_env(), capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return ""
    return done.stdout if done.returncode == 0 else ""


def video_rule_lua(geometry, pinned=True, transparency=0):
    """The window rule, as Lua for `hyprctl repl`. Numbers and fixed words
    only: nothing from outside reaches the Lua text. Pinned: on every
    workspace, above the rest; otherwise a floating window on the workspace
    it opened on.

    It goes through Omarchy's own o.window where there is one, like
    Omarchy's webcam overlay: that marks the app as floating on its own, so
    a floating workspace's open rule (which sizes every other new window to
    two thirds of the screen, centered) leaves it alone. Named, so adding it
    again replaces it; o.window also records it in Omarchy's floating-app
    list each time (no check for repeats), so after the first time (until a
    config reload empties the list) it goes in as a plain rule. A second rule turns off the floating workspace's title
    bar for it (its buttons can't minimize or maximize a pinned window). Two
    more tag it `skip-taskbar` while it's pinned, a convention of Legato's
    own (Hyprland has none): a taskbar or window switcher that honors it
    leaves the picture-in-picture window out. Not pinned, it's an ordinary
    window other windows can cover, so it keeps its taskbar button and its
    Alt+Tab entry. The rules match the window's real pin state, not
    Legato's setting, so Omarchy's own unpin (Super+O, pop out) untags it
    too: Hyprland re-checks rules when a window's pin changes, but only adds
    tags then, so a second rule takes the tag off an unpinned window (both
    tested live, Hyprland 0.56). Their own rules, not o.window's, which
    records every tag it's given as a floating app."""
    if geometry:
        x, y, w, h = (int(geometry[k]) for k in ("x", "y", "w", "h"))
        size = '{ "%d", "%d" }' % (w, h)
        move = '{ "%d", "%d" }' % (x, y)
    else:
        size = '{ "(monitor_w*7/25)", "(monitor_w*63/400)" }'
        move = '{ "(monitor_w-monitor_w*7/25-24)", "(monitor_h-monitor_w*63/400-60)" }'
    return ('local r = { name = "%(id)s", float = true, pin = %(pin)s, no_initial_focus = true, '
            'size = %(size)s, move = %(move)s } '
            'local known = false '
            'if o and o.floating_apps and o.floating_apps.class then '
            'for _, p in ipairs(o.floating_apps.class) do if p == "^%(id)s$" then known = true end end end '
            'if o and o.window and not known then o.window("^%(id)s$", r) '
            'else r.match = { class = "^%(id)s$" } hl.window_rule(r) end '
            'pcall(hl.window_rule, { name = "%(id)s-nobar", match = { class = "^%(id)s$" }, ["hyprbars:no_bar"] = true }) '
            'pcall(hl.window_rule, { name = "%(id)s-tags", match = { class = "^%(id)s$", pin = true }, tag = "+%(skip)s" }) '
            'pcall(hl.window_rule, { name = "%(id)s-untag", match = { class = "^%(id)s$", pin = false }, tag = "-%(skip)s" }) '
            '%(opacity)s'
            'return "ok"' % {"id": VIDEO_APP_ID, "skip": SKIP_TASKBAR_TAG,
                             "pin": "true" if pinned else "false",
                             "size": size, "move": move,
                             "opacity": video_opacity_lua(transparency)})


def video_opacity_lua(transparency):
    """The window's opacity, as Lua for the same `hyprctl repl` call.

    Not a window rule: on Omarchy's floating workspaces a rule (from the
    tag every window there gets) makes every window fully opaque, and it
    wins over another rule. A window's own property (`set_prop`) wins over
    rules, so it is set on the open window now, and on each new one as it
    opens (mpv may open a fresh window for the next episode) by a
    `window.open` hook, added once per Hyprland config (a reload drops it,
    as it drops the rules, and the next `video on` adds both again). The
    hook reads the level from a global, so a change needs no new hook.
    Override: the level is the window's whole opacity, not a fraction of
    the user's own window opacity.

    Only while the window doesn't have focus: mpv draws its right-click
    menu inside the window, so a see-through window has a see-through menu.
    A click (right-click too) focuses it, solid while you use it; a click
    elsewhere and it's see-through again."""
    alpha = "%.2f" % ((100 - video_transparency({"videoTransparency": transparency})) / 100.0)
    return ('legato_video_alpha = "%(alpha)s" '
            'legato_video_apply = function(w) '
            'if not (w and w.class == "%(id)s" and w.address) then return end '
            'local target = "address:" .. w.address '
            'hl.dispatch(hl.dsp.window.set_prop({ prop = "opacity", value = "1.0", window = target })) '
            'hl.dispatch(hl.dsp.window.set_prop({ prop = "opacity_inactive", value = legato_video_alpha, window = target })) '
            'for _, prop in ipairs({ "opacity_override", "opacity_inactive_override" }) do '
            'hl.dispatch(hl.dsp.window.set_prop({ prop = prop, value = "true", window = target })) end '
            'end '
            'if not (legato_video_hook and legato_video_hook:is_active()) then '
            'legato_video_hook = hl.on("window.open", function(w) pcall(legato_video_apply, w) end) end '
            'for _, w in ipairs(hl.get_windows() or {}) do pcall(legato_video_apply, w) end '
            % {"id": VIDEO_APP_ID, "alpha": alpha})


def video_pinned(prefs):
    return prefs.get("videoPinned") is not False


def video_transparency(prefs):
    level = prefs.get("videoTransparency")
    return level if isinstance(level, int) and not isinstance(level, bool) and level in TRANSPARENCY_LEVELS else 0


def transparency_label(level):
    return "%d%%" % level if level else "Off"


def video_menu(prefs):
    """The video window's right-click menu (mpv's own context menu)."""
    # Said in words: the menu's font has no check mark glyph (it draws a
    # box), though it has the submenu arrow.
    level = video_transparency(prefs)
    return [
        {"title": "Always on top: %s" % ("On" if video_pinned(prefs) else "Off"),
         "cmd": "script-message legato-video-pin toggle"},
        {"title": "Transparency: %s" % transparency_label(level), "type": "submenu",
         "submenu": [{"title": transparency_label(n) + (" (current)" if n == level else ""),
                      "cmd": "script-message legato-video-transparency %d" % n}
                     for n in TRANSPARENCY_LEVELS]},
        {"type": "separator"},
        {"title": "Pause / play", "cmd": "cycle pause"},
        {"title": "Hide video", "cmd": "set vid no"},
    ]


def place_video_window(prefs):
    """Send the placement rule (again: a Hyprland config reload drops rules
    added at run time)."""
    hyprctl("repl", video_rule_lua(saved_geometry(prefs), video_pinned(prefs), video_transparency(prefs)))


def saved_geometry(prefs):
    g = prefs.get("videoGeometry")
    if isinstance(g, dict) and all(GEOMETRY_RE.match(str(g.get(k, ""))) for k in ("x", "y", "w", "h")):
        if int(g["w"]) >= 120 and int(g["h"]) >= 68:
            return g
    return None


def remember_video_geometry(prefs):
    """Where the video window is now, so it opens there next time."""
    try:
        clients = json.loads(hyprctl("clients", "-j") or "[]")
    except ValueError:
        return
    for c in clients if isinstance(clients, list) else []:
        if isinstance(c, dict) and c.get("class") == VIDEO_APP_ID:
            if bool(c.get("pinned")) != video_pinned(prefs):
                return  # it missed the placement rule: don't learn that spot
            (x, y), (w, h) = c.get("at") or (0, 0), c.get("size") or (0, 0)
            geometry = {"x": int(x), "y": int(y), "w": int(w), "h": int(h)}
            if saved_geometry({"videoGeometry": geometry}) and geometry != prefs.get("videoGeometry"):
                prefs["videoGeometry"] = geometry
                # Saved into prefs as they are now, not as this caller read
                # them: a toggle made meanwhile must not be undone.
                with prefs_update() as fresh:
                    fresh["videoGeometry"] = geometry
            return


def set_video(player, prefs, show):
    """Show or hide the video window."""
    if show:
        if not has_video(player.snapshot()):
            raise ApiError("no_video", "This episode has no video")
        place_video_window(prefs)
        # Keys and menu for the window, again: a player started by an older
        # Legato has neither.
        bind_video_window_keys(player, prefs)
        try:  # a player started by an older Legato: no controls, full-size text
            player.command("script-message", "osc-visibility", "never", "no-osd")
            player.command("set_property", "osd-scale-by-window", False)
        except ApiError:
            pass
        # The first video of a session sets up the GPU: allow it a while.
        player.command("set_property", "vid", "auto", timeout=15)
    else:
        remember_video_geometry(prefs)
        player.command("set_property", "vid", "no", timeout=5)


def heal_filters(player, snap, prefs):
    """Put the audio filters back in line with the settings if anything
    (an mpv key, a lost command) left them out of step."""
    have = [f.get("label") for f in (snap.get("af") or []) if isinstance(f, dict)]
    want = (["trim"] if trim_filter(prefs.get("trim")) else []) + (["boost"] if prefs.get("boost") is True else [])
    if have != want:
        apply_trim(player, prefs.get("trim"))
        apply_boost(player, prefs.get("boost") is True)


def ensure_mpv(prefs):
    player = Mpv.connect()
    if player and not player.responsive():
        end_hung_player(player)
        player = None
    return player or start_mpv(prefs)


def end_hung_player(player):
    """A player that stopped answering (seen once: its video output
    deadlocked on the NVIDIA GPU) is ended, so the next play starts fresh.
    Only a process proven to be this plugin's own mpv is ever signalled: the
    kernel's peer credentials for its socket, our uid, a process named mpv,
    with our socket on its command line."""
    pid, uid = player.peer_pid()
    player.close()
    path = ""
    try:
        path = socket_path()
    except (OSError, ApiError):
        pass
    ours = False
    if pid > 1 and uid == os.geteuid() and path:
        try:
            with open("/proc/%d/comm" % pid) as fh:
                comm = fh.read().strip()
            with open("/proc/%d/cmdline" % pid, "rb") as fh:
                argv = fh.read().split(b"\0")
            ours = comm == "mpv" and ("--input-ipc-server=" + path).encode() in argv
        except OSError:
            ours = False
    if ours:
        for sig, wait in ((signal.SIGTERM, 1.0), (signal.SIGKILL, 2.0)):
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                break
            deadline = time.monotonic() + wait
            while time.monotonic() < deadline and os.path.exists("/proc/%d" % pid):
                time.sleep(0.05)
            if not os.path.exists("/proc/%d" % pid):
                break
        try:
            os.unlink(path)
        except OSError:
            pass
    return ours


def clamp_speed(value):
    try:
        speed = float(value)
    except (TypeError, ValueError):
        speed = 1.0
    return round(max(0.5, min(3.0, speed)), 2)


# ------------------------------------------------------------ playback state
#
# playback.json remembers the episode loaded into mpv (so a poll can tell
# what is playing and where to sync it), when its position was last pushed,
# and which episode's ending was already handled.

def load_playback():
    return load_state("playback.json")


def save_playback(state):
    save_state("playback.json", state)


def load_prefs():
    return load_state("prefs.json")


def load_stats():
    return load_state("stats.json")


def stats_counting(prefs):
    """Whether listening stats are counted (prefs.json `stats`; on unless
    turned off on the Stats page). A player choice, not a widget setting,
    so turning it off survives the plugin being disabled."""
    return prefs.get("stats") is not False


def add_stats(**seconds):
    """Add to the listening stats, kept only here (stats.json, 0600; nothing
    is sent anywhere), unless counting is off. Callers hold the state lock. A
    stats file that can't be read or written is left alone: stats never get
    in the way of playback."""
    try:
        if not stats_counting(load_prefs()):
            return
        stats = load_stats()  # {} for a file that isn't an object (load_json_at)
        if not isinstance(stats.get("since"), (int, float)):
            stats["since"] = int(time.time())
        for key, value in seconds.items():
            if isinstance(value, (int, float)) and value > 0:
                before = stats.get(key)
                stats[key] = round((float(before) if isinstance(before, (int, float)) else 0.0) + float(value), 3)
        # Not synced to disk: they're written each poll while playing, and a
        # crash losing the last few seconds of them is no loss.
        save_state("stats.json", stats, sync=False)
    except Exception:  # noqa: BLE001 (a DeadlinePassed isn't an Exception and still ends the call)
        pass


def listen_snap(player):
    """What count_listening reads, for commands that don't take a snapshot."""
    return {name: player.get(name) for name in ("path", "pause", "time-pos", "speed", "eof-reached", "paused-for-cache")}


def count_listening(state, snap, prefs, seeked=False):
    """count_listening_now, which can't raise into the poll or command that
    called it: stats never get in the way of playback."""
    try:
        count_listening_now(state, snap, prefs, seeked)
    except Exception:  # noqa: BLE001 (a DeadlinePassed isn't an Exception and still ends the call)
        state["listening"] = {}


def count_listening_now(state, snap, prefs, seeked=False):
    """Count the listening since the last count (stats.json) and start a new
    one from here. Runs from the poll (every 32 s while playing, and on each
    mpv event) and before a command seeks, stops or switches, under the state
    lock; no timer of its own. Listened is wall-clock time; the time saved is
    how much further the episode moved: Trim Silence's share is what moved
    beyond the speed (in the episode's own time), the rest is the speed's.

    `seeked`: mpv reported a seek since the last poll that this bridge didn't
    make (a media widget's; Legato's own seeks count before and after
    themselves). How far the episode moved means nothing then, so only the
    time listened and what the speed alone saved are counted, and only for a
    stretch no longer than a poll's (SEEKED_STRETCH_MAX) that ends playing
    (a stall or a pause can't hide behind the seek)."""
    episode = state.get("episode") or {}
    now = time.monotonic()
    position = snap.get("time-pos")
    speed = float(snap["speed"]) if isinstance(snap.get("speed"), (int, float)) and snap["speed"] > 0 else 1.0
    trim = trim_level(prefs.get("trim"))
    ours = bool(episode.get("uuid")) and snap.get("path") == episode.get("url") and isinstance(position, (int, float))
    last = state.get("listening")
    last = last if isinstance(last, dict) else {}
    if (ours and last.get("uuid") == episode.get("uuid") and last.get("speed") == speed
            and last.get("trim") == trim and isinstance(last.get("pos"), (int, float))
            and isinstance(last.get("at"), (int, float))):
        wall = now - last["at"]
        moved = position - last["pos"]
        # Played on at about its speed (a second's grace for the time a poll
        # takes to arrive). Trim Silence cuts a pause in an instant, so two
        # polls close together can see the episode jump: with it on, up to
        # three times further plus a 30 s pause.
        furthest = 3 * speed * wall + 30 if trim != "off" else speed * wall + 1
        if not 0 < wall <= LISTEN_GAP_MAX:
            pass
        elif seeked:
            if (wall <= SEEKED_STRETCH_MAX and snap.get("pause") is False
                    and snap.get("paused-for-cache") is not True):
                add_stats(listened=wall, speed=max(0.0, (speed - 1) * wall))
        elif speed * (wall - 1) <= moved <= furthest:
            trimmed = max(0.0, moved - speed * wall) if trim != "off" else 0.0
            add_stats(listened=wall, trim=trimmed, speed=max(0.0, moved - wall - trimmed))
    playing = (ours and snap.get("pause") is False and snap.get("eof-reached") is not True
               and snap.get("paused-for-cache") is not True)
    state["listening"] = ({"uuid": episode["uuid"], "pos": float(position), "at": now, "speed": speed, "trim": trim}
                          if playing else {})


def save_prefs(prefs):
    save_state("prefs.json", prefs)


@contextlib.contextmanager
def prefs_update(save=True):
    """Change prefs.json: read, change and save it under its own lock, so two
    changes at once (a toggle, and a poll learning where the video window
    was moved) never undo each other. Callers apply the change to the player
    inside it too, so the player ends up as the file says. The state lock
    may be held around this one, never the reverse: no deadlock. `save=False`
    reads them under the lock without writing (nothing changed)."""
    with StateLock(timeout=5.0, name="prefs.lock"):
        prefs = load_prefs()
        yield prefs
        if save:
            save_prefs(prefs)


def chip_item(item):
    """The fields worth keeping for the bar chip and the panel's hero."""
    if not item:
        return {}
    keep = ("type", "uuid", "podcast", "show", "name", "url", "published", "duration",
            "playedUpTo", "status", "art", "artPath")
    return {k: item.get(k) for k in keep if k in item}


def start_position(item, from_start=False):
    """Where an episode starts: the top if asked or already played, else where
    Pocket Casts has it. Even at (or past) its listed length: files often run
    longer than listed (ads inserted on the fly), and starting such a one from
    the top would push 0 to every device. One at its real end ends at once and
    is marked played."""
    if from_start or item.get("status") == STATUS_PLAYED:
        return 0
    return as_int(item.get("playedUpTo"))


def show_skips(podcast_uuid):
    """(skip intro, skip outro) in seconds for a show you follow, from the
    subscriptions list (cached ten minutes); (0, 0) for anything else."""
    try:
        shows = subscriptions()
    except ApiError:
        return 0, 0
    for show in shows:
        if show.get("uuid") == podcast_uuid:
            return as_int(show.get("startFrom")), as_int(show.get("skipLast"))
    return 0, 0


def outro_applies(listed, duration, position, skip_last):
    """Whether a show's skip-outro (`end=-N`, counted back from mpv's own
    duration) can be trusted for this file: only when mpv's duration agrees
    with Pocket Casts' listed one (ads can make the file longer, never much
    shorter). An MP3 mpv misreads short (no VBR header: 18 s of 60) would
    otherwise end at once, a clean stop that is then the end: marked played,
    and the next episode of the show the same."""
    return (isinstance(duration, (int, float)) and not isinstance(duration, bool) and listed > 0
            and duration >= listed * (1 - NO_SIZE_MARGIN) and position + skip_last < duration)


def load_into_mpv(item, prefs, position, skip_last=0):
    url = safe_media_url(item.get("url"))
    if not url:
        raise ApiError("not_found", "That episode has no playable audio link")
    check_feed_host(url, prefs)
    player = ensure_mpv(prefs)
    with player:
        ensure_feed_proxy(player)
        if player.get("options/vid") == "auto":
            # The video window is on and this episode may open it again.
            place_video_window(prefs)
        title = item.get("name") or "Legato"
        if item.get("show"):
            title = "%s — %s" % (title, item["show"])
        options = "start=%d,force-media-title=%s,pause=no" % (int(position), mpv_quote(title))
        player.command("loadfile", url, "replace", -1, options)
        player.wait_for_load()
        size, duration = player.get("stream-end"), player.get("duration")
        if skip_last and outro_applies(as_int(item.get("duration")), duration, position, skip_last):
            # The show's skip-outro: mpv ends the episode that much early, and
            # the end is handled as any other (marked played, autoplay).
            player.set("file-local-options/end", "-%d" % skip_last)
        return {"url": url, "size": size if isinstance(size, int) else None,
                "duration": duration if isinstance(duration, (int, float)) else None,
                "asked": int(position) if position > START_SLACK else None, "begun": float(position)}


def play_item(item, prefs, from_start=False, queue=True, save_previous=True, at_top=False):
    """Load `item` and record it as what's playing. Pocket Casts keeps the
    playing episode at the top of Up Next, so it goes there too (`queue`);
    callers that took `item` from the top of Up Next say so with `at_top`.

    `save_previous=False` is for a switch Pocket Casts itself asked for
    (another device moved on): the outgoing episode's local position is out
    of date then, and pushing it would rewind that device."""
    position = start_position(item, from_start)
    start_from, skip_last = show_skips(item.get("podcast", ""))
    duration = as_int(item.get("duration"))
    intro = 0
    if (position == 0 and not from_start and start_from
            and (not duration or start_from < duration - FINISH_SLACK)):
        # The show's skip-intro, for an episode starting from the top (as the
        # Pocket Casts apps do it; "play from the start" means the start).
        position = intro = start_from
    previous = load_playback()
    current = previous.get("episode") or {}
    # Switching away mid-episode: save where you were in the old one (unless
    # it just finished, which already marked it played).
    if (save_previous and current.get("uuid") and current.get("uuid") != item.get("uuid")
            and previous.get("handledEnd") != current.get("uuid")):
        save_outgoing(previous)
    stream = load_into_mpv(item, prefs, position, skip_last)
    if intro:
        add_stats(intro=intro)
    cache_art([item])
    # atTop: whether this episode is the top of Up Next, i.e. what Pocket
    # Casts considers playing. If the top later changes, another device has
    # moved on to something else (see check_server).
    state = {"episode": chip_item(item), "lastSyncAt": time.time(), "lastSyncPos": position,
             "position": position, "handledEnd": "", "atTop": bool(at_top),
             # Episodes that ended here while Pocket Casts couldn't be told.
             "pendingFinish": [p for p in previous.get("pendingFinish") or []
                               if isinstance(p, dict) and p.get("uuid") != item.get("uuid")]}
    # What mpv knew of the file as it loaded (stream_broke): its size goes
    # when the stream fails, and a duration it estimated can shrink with it.
    state["stream"] = stream
    save_playback(state)
    if queue:
        try:
            state["atTop"] = up_next_put(item, "now")
        except ApiError:
            pass
        save_playback(state)
    try:
        push_position(item, position)
    except ApiError:
        pass
    return state


def player_view(snap, state, prefs, load_failed=False):
    episode = state.get("episode") or {}
    active = bool(snap) and not snap.get("idle-active") and bool(snap.get("path"))
    duration = snap.get("duration") if active else None
    position = snap.get("time-pos") if active else None
    # mpv doesn't pause at the end of an episode (keep-open): it sits there
    # with pause off. Ended is not playing: no poll timer, and the idle
    # unload can close it.
    ended = active and snap.get("eof-reached") is True
    view = {
        "active": active,
        "playing": active and snap.get("pause") is False and not ended,
        "ended": ended,
        # Still opening the stream (no position yet) reads as buffering too,
        # rather than as playing in silence.
        "buffering": active and (snap.get("paused-for-cache") is True or not isinstance(position, (int, float))),
        # mpv gave up on the episode: it never opened, or the stream broke.
        "loadFailed": bool(load_failed),
        "position": float(position) if isinstance(position, (int, float)) else float(state.get("position") or episode.get("playedUpTo") or 0),
        "duration": float(duration) if isinstance(duration, (int, float)) and duration > 0 else float(episode.get("duration") or 0),
        "volume": int(round(snap.get("volume"))) if active and isinstance(snap.get("volume"), (int, float)) else as_int(prefs.get("volume", 100)) if "volume" in prefs else 100,
        "speed": float(snap.get("speed")) if active and isinstance(snap.get("speed"), (int, float)) else clamp_speed(prefs.get("speed", 1.0)),
        "trim": trim_level(prefs.get("trim")),
        "boost": prefs.get("boost") is True,
        "videoTransparency": video_transparency(prefs),
        "videoPinned": video_pinned(prefs),
        "localFeeds": local_feeds_allowed(prefs),
        "statsCounting": stats_counting(prefs),
        "hasVideo": active and has_video(snap),
        "video": active and video_shown(snap),
        "item": episode or None,
        "running": bool(snap),
    }
    return view


def next_in_up_next(skip_uuid):
    episodes, sync = up_next_raw()
    titles = None
    for e in episodes:
        uuid = str((e or {}).get("uuid") or "").lower()
        if uuid and uuid != skip_uuid:
            item = norm_episode(e, sync=sync.get(uuid))
            if not item:
                continue
            if not item["show"]:
                titles = titles if titles is not None else podcast_titles()
                item["show"] = titles.get(item["podcast"], "")
            if not item["url"]:
                item = resolve_episode(uuid, item["podcast"])
            return item
    return None


def finish_current(state, prefs, autoplay):
    """The episode reached its end: mark it played, take it off Up Next, and
    start the next one if autoplay is on.

    From then on it's never pushed as in progress again (sync_now, poll):
    only playing it again here (play_again) undoes that. Whatever Pocket
    Casts couldn't be told now (the network dropped) is retried on later
    polls (`pendingFinish`), while the next episode plays too."""
    episode = state.get("episode") or {}
    uuid = episode.get("uuid", "")
    add_stats(finished=1)
    state["handledEnd"] = uuid
    state["endedAutoplay"] = bool(autoplay)
    state["lastSyncAt"] = time.time()
    save_playback(state)
    entry = {"uuid": uuid, "podcast": episode.get("podcast", ""), "duration": episode.get("duration"),
             "position": episode.get("duration") or state.get("position") or 0,
             "played": False, "removed": False, "at": time.time(), "tried": time.time()}
    tell_finished(entry)
    if entry["removed"]:
        state["atTop"] = False  # off Up Next: no longer what Pocket Casts thinks is playing
    if not (entry["played"] and entry["removed"]):
        state["pendingFinish"] = [p for p in state.get("pendingFinish") or [] if p.get("uuid") != uuid] + [entry]
    save_playback(state)
    if not autoplay:
        return state
    item = next_in_up_next(uuid)
    if not item:
        return state
    # Taken off Up Next, the next one is its top already; if that failed,
    # play_now puts the next one on top (and atTop says what really is).
    return play_item(item, prefs, queue=not entry["removed"], at_top=entry["removed"])


def tell_finished(entry):
    """Mark an episode played and take it off Up Next, each step on its own;
    `entry` records which went through."""
    if not entry.get("played"):
        try:
            push_position(entry, entry.get("position") or 0, STATUS_PLAYED)
            entry["played"] = True
        except ApiError:
            pass
    if not entry.get("removed"):
        try:
            up_next_remove([entry["uuid"]])
            entry["removed"] = True
        except ApiError:
            pass
    return entry


def retry_pending_finish(state):
    """Tell Pocket Casts about episodes that ended here while it couldn't be
    reached. Given up after six hours: by then another device has had its
    say. Runs only from a poll, never on a timer of its own."""
    pending = state.get("pendingFinish") or []
    if not pending:
        return
    keep = []
    now = time.time()
    for entry in pending:
        if not isinstance(entry, dict) or not entry.get("uuid") or now - float(entry.get("at") or 0) > 6 * 3600:
            continue
        if now - float(entry.get("tried") or 0) >= 60:
            # At most once a minute: with the network down, each try holds
            # the state lock while its requests time out.
            entry["tried"] = now
            tell_finished(entry)
        if entry.get("removed") and entry["uuid"] == (state.get("episode") or {}).get("uuid"):
            state["atTop"] = False  # off Up Next now: no longer what Pocket Casts thinks is playing
        if not (entry.get("played") and entry.get("removed")):
            keep.append(entry)
    state["pendingFinish"] = keep
    save_playback(state)


def play_again(player, state, from_start):
    """Play again an episode that played to its end here (and was marked
    played): from the top, or from where it was dragged back to. That makes
    it in progress again, and this machine produced that, so it's pushed at
    once with no question to Pocket Casts (which would answer "played" and
    stop it)."""
    if from_start:
        player.command("seek", 0, "absolute")
    if player.get("pause") is not False:
        player.set("pause", False)
    position = 0.0
    if not from_start:
        at = player.get("time-pos")
        position = float(at) if isinstance(at, (int, float)) else float(state.get("position") or 0)
    reopen_ended(state, position)


def reopen_ended(state, position):
    """The state side of play_again: no longer ended, nothing to retry for
    it, and its new position pushed as in progress."""
    episode = state.get("episode") or {}
    uuid = episode.get("uuid", "")
    state["pendingFinish"] = [p for p in state.get("pendingFinish") or [] if p.get("uuid") != uuid]
    state.update({"handledEnd": "", "checkServer": False, "position": float(position), "lastSyncAt": time.time()})
    state.pop("endedAutoplay", None)
    state.pop("unconfirmed", None)
    try:
        push_position(episode, position)
        state["lastSyncPos"] = float(position)
        episode["playedUpTo"] = int(position)
    except ApiError:
        pass  # the next periodic push sends it
    save_playback(state)


def ended_here(state):
    episode = state.get("episode") or {}
    return bool(episode.get("uuid")) and state.get("handledEnd") == episode.get("uuid")


def skip_last_of(value):
    """The seconds a loadfile's `end=-N` (the show's skip-outro) cuts off, as
    mpv reports the option back ("-26"; "none" without one)."""
    value = str(value or "")
    if not value.startswith("-"):
        return 0.0
    try:
        return max(0.0, float(value[1:]))
    except ValueError:
        return 0.0


def stream_broke(snap, state):
    """mpv (keep-open) sits with `eof-reached` on both at an episode's real end
    and where its stream broke off for good (the network went, the host hung
    up or answered with an error page; mpv retries for a while first). Only
    the first finishes the episode. Calling a break the end is the worse
    mistake: it marks an unfinished episode played on every device and starts
    the next. mpv's numbers alone can't tell them apart on every host (an
    error page's length read as the size, misread MP3 durations, an M4A's
    index left unread), so it goes by what the host is and what FFmpeg says:

    1. A host that serves byte ranges (mpv: `seekable`): FFmpeg reconnects
       on any failure and logs it ("Will reconnect at N"; "Stream ends
       prematurely at N" for a clean close short of the size), which the
       watcher (bin/legato-watch.lua) records for the file playing. Recorded,
       and mpv read no further (a reconnect that worked reads on, to the
       end): a break. Nothing recorded: the end.
    2. A host that gives a size but no ranges: the stream is read straight
       through and FFmpeg can't reconnect (an https drop or a timeout logs no
       such line). The end only if mpv read to the size (READ_TO_END); short
       of it, or nothing read at all (an M4A whose index is at the back
       can't play there), a break.
    3. A host that gives no size (FFmpeg can't tell a cut from the end, and
       may log a reconnect at a real end too), an HLS playlist, or a player
       without the watcher (started by an older Legato, or refused by
       watch_script): compared with the longest duration given (Pocket
       Casts', mpv's at load or since), it's the end only within
       NO_SIZE_MARGIN of it, the skip-outro allowed for. With no duration at
       all, the end, as before 1.1.

    A real end misjudged leaves the episode in progress: Play loads it again
    at its end, which stops again and asks you to mark it played
    (stream_stopped); nothing is pushed back."""
    if snap.get("eof-reached") is not True:
        return False
    position = snap.get("time-pos")
    if not isinstance(position, (int, float)):
        return False
    loaded = state.get("stream")
    loaded = loaded if isinstance(loaded, dict) and loaded.get("url") == snap.get("path") else {}

    def number(value):
        return isinstance(value, (int, float)) and not isinstance(value, bool)

    watch = snap.get("user-data/legato")
    # The size the host gave at load, else now (after a failed reconnect mpv
    # can report an error page's length instead). An HLS episode (a playlist
    # of segments) has no one stream to measure: its playlist's durations
    # are exact, so the length rule judges it.
    size = next((s for s in (loaded.get("size"), snap.get("stream-end")) if number(s) and s > 0), None)
    hls = str(snap.get("file-format") or "").startswith("hls")
    if isinstance(watch, dict) and watch.get("watching") is True and size is not None and not hls:
        read = snap.get("stream-pos")
        to_end = number(read) and 0 <= size - read <= READ_TO_END
        cut = watch.get("cut")
        if number(cut) and not to_end and not (number(read) and read > cut + READ_PAST_CUT):
            return True
        return False if snap.get("seekable") is True else not to_end
    skip = skip_last_of(snap.get("file-local-options/end"))
    durations = [d for d in (snap.get("duration"), loaded.get("duration"), (state.get("episode") or {}).get("duration"))
                 if number(d) and d > 0]
    if not durations:
        return False
    longest = max(durations)
    return position < longest - skip - max(BROKE_SLACK, longest * NO_SIZE_MARGIN)


def end_unproven(snap, state):
    """An end that proves nothing: mpv reached it with nothing played since
    the load began (Pocket Casts' position is past this machine's copy of the
    file: ad-stitched copies differ per request), or far short of the length
    Pocket Casts lists (a placeholder clip from an expired feed). Not marked
    played: it stops, and asks you to (stream_stopped)."""
    if snap.get("eof-reached") is not True:
        return False
    position = snap.get("time-pos")
    if not isinstance(position, (int, float)):
        return False
    url = (state.get("episode") or {}).get("url")
    record = state.get("stream")
    begun = record.get("begun") if isinstance(record, dict) and record.get("url") == url else None
    if isinstance(begun, (int, float)) and position - begun < 2:
        return True  # (or ended before where it began: the file is shorter there)
    listed = (state.get("episode") or {}).get("duration")
    skip = skip_last_of(snap.get("file-local-options/end"))  # a show's skip-outro stops short on purpose
    return isinstance(listed, (int, float)) and listed > 0 and position + skip < listed * END_FAR_SHORT


def stall_seen(watch, state):
    """A stall of STALL_AFTER or more (the watcher times mpv's buffering):
    "now" while it lasts, "ended" once one is over and not yet handled
    (`stallHandled`, the time it ended), else None."""
    if not isinstance(watch, dict):
        return None
    since = watch.get("stallSince")
    if isinstance(since, (int, float)) and time.time() - since >= STALL_AFTER:
        return "now"
    handled = float(state.get("stallHandled") or 0)
    for stall in watch.get("stalls") or []:
        if not isinstance(stall, dict):
            continue
        began, ended = stall.get("since"), stall.get("ended")
        if (isinstance(began, (int, float)) and isinstance(ended, (int, float))
                and ended - began >= STALL_AFTER and ended > handled):
            return "ended"
    return None


def stalls_ended_by(watch):
    """When the last stall the watcher knows of ended (stallHandled)."""
    ends = [stall.get("ended") for stall in (watch or {}).get("stalls") or [] if isinstance(stall, dict)]
    return max([e for e in ends if isinstance(e, (int, float))], default=0)


def below_start(state, position):
    """True while playback sits short of where this load was asked to start
    (`stream`'s `asked`): a host that serves no byte ranges can't start part
    way, so mpv plays from the top. Pushing that would rewind every other
    device to it; nothing is pushed until playback passes the start (or you
    seek from a start that was honoured: cmd_seek)."""
    record = state.get("stream")
    url = (state.get("episode") or {}).get("url")
    if not isinstance(record, dict) or record.get("url") != url:
        return False
    asked = record.get("asked")
    return (isinstance(asked, (int, float)) and isinstance(position, (int, float))
            and position < asked - START_SLACK)


def learn_stream(state, snap):
    """Fill in what's known of the playing file (`stream`, stream_broke's
    evidence) from a poll: a load slower than wait_for_load's wait stored
    none, and a player an older Legato started has no record at all."""
    url = (state.get("episode") or {}).get("url")
    if not url or snap.get("path") != url:
        return
    record = state.get("stream")
    record = dict(record) if isinstance(record, dict) and record.get("url") == url else {"url": url}
    size, duration = snap.get("stream-end"), snap.get("duration")
    if not isinstance(record.get("size"), int) and isinstance(size, int) and size > 0:
        record["size"] = size
    if (isinstance(duration, (int, float)) and duration > 0
            and not (isinstance(record.get("duration"), (int, float)) and record["duration"] >= duration)):
        record["duration"] = float(duration)  # the longest mpv has reported for it
    position = snap.get("time-pos")
    if isinstance(record.get("asked"), (int, float)) and isinstance(position, (int, float)):
        if position >= record["asked"] - START_SLACK:
            record["asked"] = None  # past where it was asked to start: pushes as usual
        elif not record.get("toldStart"):
            record["toldStart"] = True
            state["tellStart"] = True  # said once (poll's view: startedFromTop)
    state["stream"] = record


def stream_stopped(state, prefs, position, stalled=False, unproven=False):
    """The episode's stream broke off part way (stream_broke): it's not
    finished. Where it got to is pushed (it was playing here, so this machine
    produced it) unless its resume is still unconfirmed or unchecked, or the
    last push is over RECHECK_AFTER old (the shell was down, the machine
    slept) or it stalled for a while first (`stalled`): another device may
    have carried on since; the next Play asks Pocket Casts anyway,
    resume_last.
    The player is closed: the next play loads it again from where Pocket
    Casts has it, like any play after the idle unload."""
    episode = state.get("episode") or {}
    if isinstance(position, (int, float)):
        state["position"] = float(position)
        recent = time.time() - float(state.get("lastSyncAt") or 0) < RECHECK_AFTER
        if (recent and not stalled and episode.get("uuid") and not state.get("unconfirmed") and not state.get("checkServer")
                and not below_start(state, position)):
            try:
                push_position(episode, position)
                state["lastSyncAt"] = time.time()
                state["lastSyncPos"] = float(position)
                episode["playedUpTo"] = int(position)
            except ApiError:
                # Pocket Casts never got it: the next Play carries on from
                # here, within the hour (resume_last).
                state["unsentBreak"] = {"uuid": episode.get("uuid"), "position": float(position), "at": time.time()}
    save_playback(state)
    player = Mpv.connect()
    if player:
        quit_mpv(player)
    view = player_view({}, state, prefs)
    view["streamBroke"] = True
    # It stopped where this load began: nothing more of it arrives. It may be
    # its end, misjudged: say how to mark it played (never done by itself).
    record = state.get("stream") or {}
    begun = record.get("begun") if isinstance(record, dict) else None
    if unproven or (isinstance(begun, (int, float)) and isinstance(position, (int, float)) and 0 <= position - begun < 2):
        view["nothingMore"] = True
    return view


# Resuming is where devices meet: this machine paused an episode, you carried
# on listening on your phone, and now this machine is about to play again from
# where *it* stopped. Pocket Casts is asked first, every time, and its answer
# wins: further into the episode (seek there), finished and on to the next one
# (play that), or nothing left (stop). Without this, the next position push
# rewinds the phone to where this machine paused.

def check_server(state, prefs, player=None, quick=False):
    """Bring the loaded episode in line with Pocket Casts before it plays on.

    Returns (outcome, state) with outcome one of:
      "same"       carry on with this episode, seeked to Pocket Casts'
                   position if another device moved it;
      "switched"   another device moved on to a different episode, which is
                   now loaded and playing;
      "finished"   another device finished this episode and Up Next is
                   empty; the player is stopped;
      "unverified" Pocket Casts could not be asked; nothing changed.
    """
    episode = state.get("episode") or {}
    uuid = episode.get("uuid")
    if not uuid:
        return "same", state
    try:
        # `quick`: a press of Play waits RESUME_CHECK_TIMEOUT per request (plus
        # a sign-in refresh when one is due, at most hourly, at its own
        # TOKEN_TIMEOUT); a poll's check (playing on its own already) takes
        # the usual time, so a slow link still gets its answer and its pushes.
        with http_timeout(RESUME_CHECK_TIMEOUT) if quick else contextlib.nullcontext():
            top = up_next_top()
            record = user_episode(uuid)
    except ApiError:
        return "unverified", state
    finished = as_int(record.get("playingStatus")) == STATUS_PLAYED
    moved_on = top is not None and top["uuid"] != uuid and (finished or state.get("atTop") is True)
    if moved_on:
        try:
            item = resolve_episode(top["uuid"], top.get("podcast", ""))
        except ApiError:
            return "unverified", state
        return "switched", play_item(item, prefs, queue=False, save_previous=False, at_top=True)
    if finished:
        own = player is None
        player = player or Mpv.connect()
        if player:
            quit_mpv(player)
            if own:
                player.close()
        state["handledEnd"] = uuid
        state["checkServer"] = False
        state.pop("unconfirmed", None)
        save_playback(state)
        return "finished", state

    if record:
        server = as_int(record.get("playedUpTo"))
        pushed = float(state.get("lastSyncPos") or 0)
        local = float(state.get("position") or 0)
        # Keep a local position Pocket Casts never received (its push failed)
        # when it is further on than what another device saved, within the
        # hour (a phone rewound on purpose later wins).
        keep_local = (moved_since_push(state) and local > server
                      and time.time() - float(state.get("lastSyncAt") or 0) < UNSENT_BREAK_KEPT)
        if abs(server - pushed) > DRIFT_SLACK and not keep_local:
            own = player is None
            player = player or Mpv.connect()
            if player:
                try:
                    player.command("seek", server, "absolute")
                finally:
                    if own:
                        player.close()
            stream = state.get("stream")
            if server > local + START_SLACK and isinstance(stream, dict) and stream.get("url") == episode.get("url"):
                # A host without byte ranges can't seek ahead: mpv plays on
                # from where it was. Nothing is pushed below Pocket Casts'
                # position until playback gets there (below_start).
                stream["asked"] = server
            state["position"] = float(server)
            state["lastSyncPos"] = float(server)
            episode["playedUpTo"] = server
    state["checkServer"] = False
    state.pop("unconfirmed", None)  # Pocket Casts has answered
    state["lastSyncAt"] = time.time()
    save_playback(state)
    return "same", state


def resume_loaded(player, state, prefs):
    """Unpause the loaded episode once Pocket Casts has said what should play
    and from where. Raises when another device finished it and nothing is
    left to play."""
    at_end = player.get("eof-reached") is True
    if player.get("pause") is False and not at_end:
        return  # already playing (a media key got there first)
    if at_end:
        snap = player.snapshot()
        broke = snap.get("path") == (state.get("episode") or {}).get("url") and stream_broke(snap, state)
        unproven = not broke and snap.get("path") == (state.get("episode") or {}).get("url") and end_unproven(snap, state)
        if broke or unproven:
            # Its stream broke off before a poll saw it: not the end (playing it
            # again from the top would push 0). Load it again from where it got to.
            # (An end that proved nothing loads again too: if it stops at
            # once again, the poll says the stream ends there.)
            stream_stopped(state, prefs, snap.get("time-pos"), unproven=unproven,
                           stalled=bool(stall_seen(snap.get("user-data/legato"), state)))
            resume_last(prefs)
            return
    if at_end or ended_here(state):
        # It played to its end here and is still loaded. With autoplay on,
        # nothing followed it (Up Next was empty, or Pocket Casts didn't
        # answer): play what's queued now, if anything is. Otherwise play it
        # again: from the top, or from where it was dragged back to.
        if at_end and state.get("endedAutoplay"):
            item = next_in_up_next((state.get("episode") or {}).get("uuid", ""))
            if item:
                play_item(item, prefs)
                return
        play_again(player, state, from_start=at_end)
        return
    outcome, state = check_server(state, prefs, player, quick=True)
    if outcome == "switched":
        return
    if outcome == "finished":
        raise ApiError("finished_elsewhere", "Finished on another device, and Up Next is empty")
    if outcome == "unverified":
        # It plays (you pressed play), but where it is wasn't confirmed:
        # nothing is pushed until a poll gets Pocket Casts' answer (rule 2).
        state["unconfirmed"] = True
        save_playback(state)
    player.set("pause", False)


def poll(autoplay=True, seeked=False):
    """Read mpv, sync the position to Pocket Casts when it's due, and handle an
    episode that just ended. Runs under the state lock."""
    state = load_playback()
    prefs = load_prefs()
    player = Mpv.connect()
    if not player:
        return player_view({}, state, prefs)
    if not player.responsive():
        # Nothing is pushed: whatever played last was already sent, and the
        # next play asks Pocket Casts where to pick up.
        end_hung_player(player)
        state["checkServer"] = True
        save_playback(state)
        view = player_view({}, state, prefs)
        view["playerHung"] = True
        return view
    with player:
        snap = player.snapshot()
    episode = state.get("episode") or {}
    url = episode.get("url") or ""
    if not snap.get("path"):
        # Nothing loaded. If mpv still lists an episode, loading it failed
        # (its server didn't answer, say) or its stream broke: close the
        # player and say so. Nothing is pushed: whatever played last was
        # already sent, and an idle player must never resume or switch.
        if episode.get("uuid") and snap.get("idle-active") is True and as_int(snap.get("playlist-count")) > 0:
            player = Mpv.connect()
            if player:
                quit_mpv(player)
            return player_view({}, state, prefs, load_failed=True)
        return player_view(snap, state, prefs)
    if not episode.get("uuid") or snap.get("path") != url:
        # mpv is playing something this plugin did not load.
        return player_view(snap, state, prefs)
    count_listening(state, snap, prefs, seeked)
    learn_stream(state, snap)
    position = snap.get("time-pos")
    if isinstance(position, (int, float)):
        state["position"] = float(position)
    if state.get("handledEnd") != episode.get("uuid"):
        broke = stream_broke(snap, state)
        unproven = not broke and end_unproven(snap, state)
        if broke or unproven:
            # Not the end: the stream broke off, or the end proves nothing.
            # Say so; nothing is marked played.
            return stream_stopped(state, prefs, position, unproven=unproven,
                                  stalled=bool(stall_seen(snap.get("user-data/legato"), state)))
    if snap.get("eof-reached") is True and state.get("handledEnd") != episode.get("uuid"):
        outro = skip_last_of(snap.get("file-local-options/end"))
        if outro:
            add_stats(outro=outro)
        state = finish_current(state, prefs, autoplay)
        return poll_after_change(state, prefs)
    retry_pending_finish(state)
    if snap.get("eof-reached") is True:
        # Ended here and marked played: nothing to push or check until it's
        # played again. (mpv doesn't pause at the end; the view says ended.)
        save_playback(state)
        return player_view(snap, state, prefs)
    if ended_here(state) and snap.get("pause") is False and isinstance(position, (int, float)):
        # Dragged back into an episode that ended here (a media widget's
        # seek), and it plays on: it's in progress again.
        reopen_ended(state, position)
        return player_view(snap, state, prefs)
    now = time.time()
    stall = stall_seen(snap.get("user-data/legato"), state)
    if stall:
        # Stuck for a while (the link went quiet): an interruption, like a
        # pause. Nothing is pushed while it lasts (you may carry on with your
        # phone meanwhile), nor after it until Pocket Casts has been asked
        # (`unconfirmed`: a pause meanwhile pushes nothing either).
        state["checkServer"] = True
        state["unconfirmed"] = True
        if stall == "now":
            save_playback(state)
            return player_view(snap, state, prefs)
        state["stallHandled"] = stalls_ended_by(snap.get("user-data/legato"))
    if snap.get("pause") is True:
        # Whoever paused it (this panel, a media key, playerctl), the next
        # resume asks Pocket Casts first.
        state["checkServer"] = True
    elif snap.get("pause") is False and (state.get("checkServer")
                                         or now - float(state.get("lastSyncAt") or 0) >= RECHECK_AFTER):
        # Playing again without a resume through this bridge (a media key,
        # playerctl), or after an interruption (the machine slept): another
        # device may have moved on meanwhile, so ask before pushing anything.
        outcome, state = check_server(state, prefs)
        if outcome in ("switched", "finished"):
            return poll_after_change(state, prefs)
        if outcome == "unverified":
            state["checkServer"] = True  # ask again next time
            state["unconfirmed"] = True  # and push nothing until Pocket Casts answers
            save_playback(state)
            return player_view(snap, state, prefs)
        return poll_after_change(state, prefs)
    due = False
    if (snap.get("pause") is False and now - float(state.get("lastSyncAt") or 0) >= SYNC_INTERVAL
            and snap.get("paused-for-cache") is not True and moved_since_push(state)):
        # Only a position playing here produces (rule 1). A stalled stream
        # (buffering, the link gone quiet) sits still: pushing it pulled the
        # phone you carried on with back to the stall, every poll, and kept
        # the last push fresh, so the gap check never asked first. Unpushed,
        # the gap grows, and once it plays again Pocket Casts is asked.
        due = True
    elif (snap.get("pause") is True and moved_since_push(state) and not state.get("unconfirmed")
          and now - float(state.get("lastSyncAt") or 0) < RECHECK_AFTER):
        # Paused somewhere new (a seek from a media widget): send it. A paused
        # position left unsent from before an interruption (the machine slept
        # before the push went out) isn't pushed blind: another device may
        # have moved on since, and the next resume asks Pocket Casts first.
        due = True
    if video_shown(snap):
        remember_video_geometry(prefs)  # so a window closed with its own X reopens where it was
    with Mpv.connect() or contextlib.nullcontext() as fixer:
        if fixer:
            # From prefs as they are now (a toggle may have landed since this
            # poll began), under their lock, so a toggle isn't undone.
            with prefs_update(save=False) as fresh:
                heal_filters(fixer, snap, fresh)
    if due and below_start(state, position):
        due = False  # mpv couldn't start where asked: don't rewind the others to here
    if due and isinstance(position, (int, float)):
        try:
            push_position(episode, position)
            state["lastSyncAt"] = now
            state["lastSyncPos"] = float(position)
            episode["playedUpTo"] = int(position)
            state.pop("pushFailures", None)
        except ApiError:
            state["lastSyncAt"] = now  # try again next interval, not every poll
            state["pushFailures"] = int(state.get("pushFailures") or 0) + 1
    view = player_view(snap, state, prefs)
    if state.get("pushFailures") == PUSH_FAILURES_SAID:
        view["syncFailed"] = True  # said once per run of failures
    if state.pop("tellStart", None):
        view["startedFromTop"] = True
    save_playback(state)
    return view


def poll_after_change(state, prefs):
    player = Mpv.connect()
    if not player:
        return player_view({}, state, prefs)
    with player:
        return player_view(player.snapshot(), state, prefs)


def moved_since_push(state):
    """True when the loaded episode's position has moved since it was last
    pushed to Pocket Casts."""
    return abs(float(state.get("position") or 0) - float(state.get("lastSyncPos") or 0)) >= 1


def sync_now(player, state, force=False):
    """Push the current position right away, if this machine produced it.

    `force`: it was just playing here (a pause, or a seek while playing),
    pushed if that stretch was confirmed by Pocket Casts and recent. Otherwise (stop, next, switching
    episodes, a seek while paused) a playing episode is pushed unless its
    resume is still unconfirmed (Pocket Casts couldn't be asked), and a
    paused one only if it moved since its last push and that push was
    recent (under RECHECK_AFTER, the poll's rule too). An older paused
    position is old news: another device may have carried on from it since,
    and pushing it would rewind that device; the next resume asks first.
    An episode at its end is never pushed as in progress (it's played)."""
    episode = state.get("episode") or {}
    position = player.get("time-pos")
    if not episode.get("uuid") or not isinstance(position, (int, float)):
        return
    state["position"] = float(position)
    if stall_seen(player.get("user-data/legato"), state):
        # Where a stalled stream got stuck isn't news: you may have carried
        # on with your phone meanwhile. Nothing is pushed until Pocket Casts
        # has been asked.
        state["checkServer"] = True
        state["unconfirmed"] = True
        save_playback(state)
        return
    if player.get("eof-reached") is True or state.get("unconfirmed") or below_start(state, position):
        # At the end (it's played), on a resume Pocket Casts never
        # confirmed (nothing is pushed until it answers, rule 2), or short of
        # where a host without ranges couldn't start (below_start).
        save_playback(state)
        return
    recent = time.time() - float(state.get("lastSyncAt") or 0) < RECHECK_AFTER
    if not force and player.get("pause") is not False:
        # Paused: only if it moved since its last push, and that was recent.
        if not (moved_since_push(state) and recent):
            save_playback(state)
            return
    elif state.get("checkServer") or not recent:
        # Playing, or just paused from playing (`force`): only a stretch that
        # Pocket Casts confirmed and that has played here since. Not after a
        # resume nobody checked (a media key: `checkServer`), nor after a gap
        # (the machine slept unguarded, the shell was down): another device
        # may have moved on, and the next resume asks first.
        save_playback(state)
        return
    try:
        push_position(episode, position)
        state["lastSyncAt"] = time.time()
        state["lastSyncPos"] = float(position)
    except ApiError:
        pass
    save_playback(state)


def save_outgoing(state):
    """Before another episode replaces the loaded one, push where the loaded
    one got to, by the same rule as sync_now. With no player to ask, nothing
    is pushed: the episode's last push stands."""
    url = (state.get("episode") or {}).get("url") or ""
    player = Mpv.connect()
    if not player:
        return
    with player:
        if url and player.get("path") == url:
            count_listening(state, listen_snap(player), load_prefs())
            sync_now(player, state)


def quit_mpv(player):
    """Ask mpv to quit and wait (briefly) until its socket stops answering, so
    the next command starts a fresh player instead of reaching a dying one."""
    try:
        player.command("quit")
    except ApiError:
        pass
    player.close()
    deadline = time.monotonic() + 3
    while time.monotonic() < deadline:
        probe = Mpv.connect(timeout=0.3)
        if not probe:
            return
        probe.close()
        time.sleep(0.05)


def require_player():
    player = Mpv.connect()
    if not player:
        raise ApiError("no_player", "Nothing is playing")
    return player


# -------------------------------------------------------------- subcommands

def cmd_status(args):
    auth = load_auth()
    state = load_playback()
    episode = state.get("episode") or {}
    if episode.get("art") and not episode.get("artPath"):
        cache_art([episode])
    out({
        "authenticated": bool(auth.get("refresh_token") or auth.get("access_token")) and not auth.get("needs_reauth"),
        "needsReauth": bool(auth.get("needs_reauth")),
        "email": auth.get("email", ""),
        "mpv": trusted_tool("mpv"),
        "mpris": bool(mpris_script()),
        "running": Mpv.connect(timeout=0.5) is not None,
        # Where the panel listens for mpv's events (pause, seek, end of file)
        # instead of polling: the same checked private directory the bridge
        # starts mpv in.
        "socket": player_socket(),
        "last": chip_item(episode),
        "python": "%d.%d.%d" % sys.version_info[:3],  # for the About page
    })


def read_credentials():
    """Email and password arrive as one JSON line on stdin — never in argv,
    where `ps` and crash reports could read them."""
    raw = sys.stdin.buffer.read(8192)
    try:
        data = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise ApiError("bad_args", "Login details did not arrive")
    email = str((data or {}).get("email") or "").strip()
    password = str((data or {}).get("password") or "")
    if not EMAIL_RE.match(email) or not password or len(password) > 1024:
        raise ApiError("bad_args", "Enter the email and password of your Pocket Casts account")
    return email, password


def cmd_login(args):
    email, password = read_credentials()
    status, payload = post_json("/user/login_pocket_casts", {"email": email, "password": password})
    password = None
    if status != 200 or not payload.get("accessToken"):
        message = error_text(payload, status)
        if status in (400, 401, 403):
            if str(payload.get("errorMessageId") or "").startswith("login_"):
                message = message + ". Signed in with Apple or Google? Set a password on your Pocket Casts account first."
            raise ApiError("login_failed", message, status)
        raise ApiError("network", message, status)
    auth = {}
    with auth_lock():
        store_tokens(auth, payload)  # a new session: replaces whatever was there
    for name in ("podcasts-cache.json",):
        drop_state(name)
    out({"email": auth.get("email", email)})


# ------------------------------------------------------------ feed proxy
#
# Episode addresses come from podcast feeds, which anyone can publish: a feed
# (or a redirect it leads to) could point mpv at this computer or at other
# machines on the local network. So mpv fetches through a small proxy that
# checks every connection when it's made: it resolves the host itself and
# connects only to an address the rules allow, then checks the peer it got
# (a DNS answer that changes between lookups can't slip through, and every
# redirect is a new request through here). Public addresses always pass; the
# local network (private ranges, Tailscale's 100.64.0.0/10, unique-local
# IPv6) only with the localFeeds setting on, for a home media server; this
# computer itself and link-local addresses (cloud metadata) never.
#
# HTTPS stays end to end: mpv asks for a tunnel (CONNECT host:port), so the
# proxy sees where, not what, and mpv still checks the certificate. The
# proxy listens on 127.0.0.1 only, answers only mpv (a random password per
# session, handed over on stdin), and exits when mpv does (it waits on mpv's
# pidfd, no timer).

PROXY_USER = "legato"
PROXY_HEAD_MAX = 16 * 1024
PROXY_CONNECT_TIMEOUT = 15


class FeedRefused(Exception):
    pass


def local_feeds_allowed(prefs=None):
    return (prefs if prefs is not None else load_prefs()).get("localFeeds") is True


def feed_address_allowed(address, allow_local):
    """May mpv fetch from this IP address?"""
    try:
        ip = ipaddress.ip_address(address)
    except ValueError:
        return False
    if ip.version == 6 and ip.ipv4_mapped:
        ip = ip.ipv4_mapped
    if ip.is_loopback or ip.is_link_local or ip.is_multicast or ip.is_unspecified or ip.is_reserved:
        return False  # this computer, link-local (cloud metadata), broadcast: never
    if ip.is_global:
        return True
    return bool(allow_local)  # private ranges, CGNAT (Tailscale), unique-local IPv6


def resolve_feed_host(host, port):
    try:
        return socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
    except (socket.gaierror, UnicodeError, OSError, ValueError):
        return []


def keep_alive(sock):
    """TCP keepalive on a feed connection. mpv's own network timeout doesn't
    reach inside the https tunnel, so a path that died without a word (Wi-Fi
    gone, a NAT or VPN dropping it) left mpv buffering for as long as TCP
    waits, hours. Probed after 20 s of silence, it fails within about a
    minute: the relay closes, mpv reconnects or gives up, and the watcher
    sees the break. (A server that's alive but sends nothing still stalls:
    nothing is pushed meanwhile, poll.)"""
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
    for name, value in (("TCP_KEEPIDLE", 20), ("TCP_KEEPINTVL", 10), ("TCP_KEEPCNT", 4)):
        if hasattr(socket, name):
            sock.setsockopt(socket.IPPROTO_TCP, getattr(socket, name), value)


def connect_feed_host(host, port, allow_local):
    """A socket to `host` on an allowed address, checked again once
    connected. Raises FeedRefused when no address may be used."""
    for family, kind, proto, _, sockaddr in resolve_feed_host(host, port):
        if not feed_address_allowed(sockaddr[0], allow_local):
            continue
        sock = socket.socket(family, kind, proto)
        sock.settimeout(PROXY_CONNECT_TIMEOUT)
        try:
            sock.connect(sockaddr)
            if feed_address_allowed(sock.getpeername()[0], allow_local):
                keep_alive(sock)
                return sock
        except OSError:
            pass
        sock.close()
    raise FeedRefused(host)


def check_feed_host(url, prefs):
    """Before a load: a clear message for an episode on the local network
    (or this computer), rather than mpv's "403". The proxy is what enforces
    it; this only explains it."""
    parts = urllib.parse.urlsplit(url)
    port = parts.port or (443 if parts.scheme == "https" else 80)
    addresses = [info[4][0] for info in resolve_feed_host(parts.hostname or "", port)]
    if not addresses or any(feed_address_allowed(a, local_feeds_allowed(prefs)) for a in addresses):
        return  # public (or unresolvable: mpv reports that)
    if any(feed_address_allowed(a, True) for a in addresses):
        raise ApiError("local_feed", "This episode is on your local network. To play it, turn on "
                                     "local network feeds in Legato's Settings.")
    raise ApiError("local_feed", "This episode's address is on this computer, which Legato never plays from.")


def proxy_send(conn, status, extra=""):
    try:
        conn.sendall(("HTTP/1.1 %s\r\n%sContent-Length: 0\r\nConnection: close\r\n\r\n" % (status, extra)).encode())
    except OSError:
        pass


def relay(a, b):
    """Copy both ways until both sides are done. No idle timeout: a paused
    episode keeps its connection, as it would without the proxy."""
    a.settimeout(None)
    b.settimeout(None)
    live = {a: True, b: True}
    while live[a] or live[b]:
        ready, _, _ = select.select([s for s in (a, b) if live[s]], [], [])
        for sock in ready:
            other = b if sock is a else a
            try:
                data = sock.recv(65536)
            except OSError:
                data = b""
            if not data:
                live[sock] = False
                try:
                    other.shutdown(socket.SHUT_WR)
                except OSError:
                    pass
                continue
            try:
                other.sendall(data)
            except OSError:
                return


class FeedProxy:
    HOP_HEADERS = ("proxy-authorization", "proxy-connection", "connection", "keep-alive")

    def __init__(self, token, allow_local=local_feeds_allowed):
        self.token = token
        self.allow_local = allow_local  # read per connection: a change applies at once
        self.listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.listener.bind(("127.0.0.1", 0))
        self.listener.listen(32)
        self.port = self.listener.getsockname()[1]

    def url(self):
        return "http://%s:%s@127.0.0.1:%d" % (PROXY_USER, self.token, self.port)

    def serve(self, stop_fd=None):
        while True:
            watched = [self.listener] + ([stop_fd] if stop_fd is not None else [])
            ready, _, _ = select.select(watched, [], [])
            if stop_fd is not None and stop_fd in ready:
                return
            try:
                conn, _ = self.listener.accept()
            except OSError:
                continue
            threading.Thread(target=self.handle, args=(conn,), daemon=True).start()

    def authorized(self, headers):
        expected = "Basic " + base64.b64encode(("%s:%s" % (PROXY_USER, self.token)).encode()).decode()
        return hmac.compare_digest(headers.get("proxy-authorization", "").encode(), expected.encode())

    def handle(self, conn):
        upstream = None
        try:
            conn.settimeout(30)
            head, rest = b"", b""
            while b"\r\n\r\n" not in head:
                chunk = conn.recv(4096)
                if not chunk:
                    return
                head += chunk
                if len(head) > PROXY_HEAD_MAX:
                    return proxy_send(conn, "431 Request Header Fields Too Large")
            head, rest = head.split(b"\r\n\r\n", 1)
            lines = head.decode("latin-1").split("\r\n")
            parts = lines[0].split(" ")
            if len(parts) != 3:
                return proxy_send(conn, "400 Bad Request")
            method, target, version = parts
            headers = {}
            for line in lines[1:]:
                name, _, value = line.partition(":")
                headers[name.strip().lower()] = value.strip()
            if not self.authorized(headers):
                return proxy_send(conn, "407 Proxy Authentication Required", 'Proxy-Authenticate: Basic realm="legato"\r\n')
            if method == "LEGATO-PING":
                return proxy_send(conn, "204 No Content", "X-Legato: proxy\r\n")
            allow_local = self.allow_local()
            if method == "CONNECT":
                host, _, port = target.rpartition(":")
                if not host or not port.isdigit():
                    return proxy_send(conn, "400 Bad Request")
                upstream = connect_feed_host(host.strip("[]"), int(port), allow_local)
                conn.sendall(b"HTTP/1.1 200 Connection established\r\n\r\n")
                if rest:
                    upstream.sendall(rest)
            else:
                url = urllib.parse.urlsplit(target)
                if url.scheme != "http" or not url.hostname:
                    return proxy_send(conn, "400 Bad Request")
                upstream = connect_feed_host(url.hostname, url.port or 80, allow_local)
                path = (url.path or "/") + ("?" + url.query if url.query else "")
                out_lines = ["%s %s %s" % (method, path, version)]
                for line in lines[1:]:
                    name = line.partition(":")[0].strip().lower()
                    if name and name not in self.HOP_HEADERS:
                        out_lines.append(line)
                out_lines.append("Connection: close")
                upstream.sendall(("\r\n".join(out_lines) + "\r\n\r\n").encode("latin-1") + rest)
            relay(conn, upstream)
        except FeedRefused:
            proxy_send(conn, "403 Forbidden", "X-Legato: refused (local address)\r\n")
        except (OSError, UnicodeError, ValueError):
            pass
        finally:
            for sock in (conn, upstream):
                if sock is not None:
                    try:
                        sock.close()
                    except OSError:
                        pass


def proxy_alive(url):
    """True when the proxy at `url` answers our ping with our password."""
    parts = urllib.parse.urlsplit(url or "")
    if parts.hostname != "127.0.0.1" or not parts.port or not parts.password:
        return False
    auth = base64.b64encode(("%s:%s" % (parts.username, parts.password)).encode()).decode()
    try:
        with socket.create_connection(("127.0.0.1", parts.port), timeout=1) as sock:
            sock.sendall(("LEGATO-PING / HTTP/1.1\r\nProxy-Authorization: Basic %s\r\n\r\n" % auth).encode())
            return sock.recv(256).startswith(b"HTTP/1.1 204")
    except OSError:
        return False


def start_feed_proxy(watch_pid):
    """A proxy for the mpv with this pid (it exits when mpv does); its URL."""
    token = secrets.token_hex(16)
    proc = subprocess.Popen([sys.executable, "-I", "-B", os.path.realpath(__file__), "proxy", "--watch-pid", str(int(watch_pid))],
                            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                            env=child_env(), start_new_session=True)
    try:
        proc.stdin.write((token + "\n").encode())  # not in argv: /proc shows that to everyone
        proc.stdin.close()
        ready, _, _ = select.select([proc.stdout], [], [], 5)
        line = proc.stdout.readline() if ready else b""
        port = int(json.loads(line.decode() or "{}").get("port") or 0)
    except (OSError, ValueError):
        port = 0
    finally:
        proc.stdout.close()
    if not port:
        proc.kill()
        raise ApiError("proxy", "Couldn't start Legato's feed check")
    return "http://%s:%s@127.0.0.1:%d" % (PROXY_USER, token, port)


def ensure_feed_proxy(player):
    """mpv fetches through a live feed proxy (players started by an older
    Legato have none: one is started for them too)."""
    try:
        current = player.get("http-proxy") or ""
    except ApiError:
        current = ""
    if current and proxy_alive(current):
        return
    pid, uid = player.peer_pid()
    if pid <= 1 or uid != os.geteuid():
        raise ApiError("proxy", "Couldn't tell which player to check feeds for")
    player.set("http-proxy", start_feed_proxy(pid))


def cmd_proxy(args):
    token = sys.stdin.readline().strip()
    if not re.fullmatch(r"[0-9a-f]{32}", token):
        raise ApiError("proxy", "No password for the proxy")
    watched = os.pidfd_open(args.watch_pid)  # readable once mpv exits
    proxy = FeedProxy(token)
    print(json.dumps({"port": proxy.port}), flush=True)
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, 1)
    proxy.serve(stop_fd=watched)


def cmd_localfeeds(args):
    with prefs_update() as prefs:
        on = not local_feeds_allowed(prefs) if args.value == "toggle" else args.value == "on"
        prefs["localFeeds"] = on
    out({"localFeeds": on})


# ------------------------------------------------------------ paste
#
# The sign-in fields aren't native Qt text inputs (those read the clipboard
# by themselves, unbounded: Qt 6.12's TextInput fetches offered text whenever
# it changes). A paste in them (Ctrl+V, Shift+Insert, middle-click) comes
# through here instead: wl-paste in its own process group, at most
# PASTE_MAX_BYTES and PASTE_TIMEOUT, the whole group killed on overflow, on
# timeout, and when the panel cancels the paste (SIGTERM).

PASTE_MAX_BYTES = 4096
PASTE_TIMEOUT = 2.0


def kill_group(proc):
    try:
        os.killpg(proc.pid, signal.SIGKILL)  # wl-paste and the cat it forks
    except (ProcessLookupError, PermissionError):
        pass
    try:
        proc.wait(timeout=1)
    except subprocess.TimeoutExpired:
        pass


def read_bounded_paste(proc, limit=PASTE_MAX_BYTES, timeout=PASTE_TIMEOUT):
    """Up to `limit` bytes from proc.stdout before `timeout`, else an error."""
    deadline = time.monotonic() + timeout
    fd = proc.stdout.fileno()
    chunks, size = [], 0
    while True:
        left = deadline - time.monotonic()
        if left <= 0:
            raise ApiError("paste_timeout", "The clipboard didn't answer in time")
        ready, _, _ = select.select([fd], [], [], left)
        if not ready:
            continue
        chunk = os.read(fd, 1024)
        if not chunk:
            return b"".join(chunks)
        size += len(chunk)
        if size > limit:
            raise ApiError("paste_too_long", "What's on the clipboard is too long to paste here")
        chunks.append(chunk)


def cmd_paste(args):
    tool = trusted_tool("wl-paste")
    if not tool:
        raise ApiError("no_wl_paste", "wl-paste is needed to paste")
    argv = [tool, "--no-newline", "--type", "text"] + (["--primary"] if args.primary else [])
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                            env=child_env(), start_new_session=True)

    def cancelled(*_):
        kill_group(proc)
        sys.exit(0)

    signal.signal(signal.SIGTERM, cancelled)  # the panel gave up on this paste
    try:
        blob = read_bounded_paste(proc)
    finally:
        kill_group(proc)
    text = blob.decode("utf-8", "replace")
    # One line, no control characters: these fields take an email or a password.
    text = "".join(ch for ch in text if ch >= " " and ch != "\x7f")  # spaces kept: a password may have them
    out({"text": text})


def cmd_logout(args):
    player = Mpv.connect()
    if player:
        quit_mpv(player)
    with auth_lock():
        # A refresh under way finishes first (it holds this lock); one that
        # starts later finds no session and writes nothing.
        clear_auth()
    for name in ("podcasts-cache.json", "playback.json"):
        drop_state(name)
    if load_auth():
        raise ApiError("logout", "Couldn't delete the sign-in tokens in ~/.local/state/omarchy-legato")
    out({})


def cmd_player(args):
    with StateLock():
        view = poll(autoplay=not args.no_autoplay, seeked=args.seeked)
    if view.get("item") and view["item"].get("art") and not view["item"].get("artPath"):
        cache_art([view["item"]])
    out(view)


def cmd_play(args):
    uuid = safe_uuid(args.uuid)
    podcast = safe_uuid(args.podcast) if args.podcast else ""
    with StateLock():
        item = resolve_episode(uuid, podcast)
        prefs = load_prefs()
        play_item(item, prefs, from_start=args.from_start)
        view = poll_after_change(load_playback(), prefs)
    out(view)


def resume_last(prefs):
    """Nothing is loaded (mpv was closed, or the machine restarted): pick up
    the last episode where Pocket Casts says you left it (or further, where
    this machine got to and couldn't tell it), else the top of Up Next.
    Another device may have finished it or moved on to something else
    since; then the top of Up Next is what plays, and the last episode is
    neither restarted nor queued again."""
    state = load_playback()
    episode = state.get("episode") or {}
    item = None
    if episode.get("uuid") and state.get("handledEnd") != episode.get("uuid"):
        try:
            item = resolve_episode(episode["uuid"], episode.get("podcast", ""))
        except ApiError:
            item = None
        if item and item.get("status") == STATUS_PLAYED:
            item = None
        if item and state.get("atTop") is True:
            try:
                top = up_next_top()
            except ApiError:
                top = None
            if top and top["uuid"] != item["uuid"]:
                item = None
    unsent = state.get("unsentBreak")
    if (item and isinstance(unsent, dict) and unsent.get("uuid") == item.get("uuid")
            and time.time() - float(unsent.get("at") or 0) < UNSENT_BREAK_KEPT
            and isinstance(unsent.get("position"), (int, float))
            and unsent["position"] > as_int(item.get("playedUpTo"))):
        # The stream broke while Pocket Casts couldn't be told where it got to
        # (stream_stopped): carry on from there, within the hour. Pocket Casts
        # being further on (another device listened on) wins, as always.
        item = dict(item, playedUpTo=int(unsent["position"]))
    if not item:
        item = next_in_up_next("")
    if not item:
        raise ApiError("nothing_queued", "Up Next is empty — pick an episode to play")
    # The outgoing player is gone: nothing of it is pushed here (play_item
    # pushes the position it starts from).
    play_item(item, prefs, save_previous=False)


def cmd_toggle(args):
    with StateLock():
        prefs = load_prefs()
        state = load_playback()
        player = Mpv.connect()
        idle = True
        if player:
            with player:
                idle = player.get("idle-active") is True or not player.get("path")
                if not idle:
                    at_end = player.get("eof-reached") is True
                    playing = player.get("pause") is False and not at_end
                    if args.action == "pause" or (args.action == "toggle" and playing):
                        # The stretch up to now, before the pause (the poll that
                        # sees it can arrive seconds later, under a slow push).
                        count_listening(state, listen_snap(player), prefs)
                        player.set("pause", True)
                        state["listening"] = {}
                        # Pausing what was already paused sends nothing new;
                        # an unconfirmed resume sends nothing (sync_now).
                        sync_now(player, state, force=playing)
                        state["checkServer"] = True  # the next resume asks first
                        save_playback(state)
                    else:
                        resume_loaded(player, state, prefs)
        if idle and args.action != "pause":
            resume_last(prefs)
        view = poll_after_change(load_playback(), prefs)
    out(view)


def cmd_seek(args):
    with StateLock():
        state = load_playback()
        loaded = (state.get("episode") or {}).get("uuid", "")
        if args.episode and safe_uuid(args.episode) != loaded:
            # The panel sends seeks after a short pause to gather steps; a
            # Next or a new episode got there first. Skipping into the new
            # one (or past its end) would be wrong: drop the seek.
            out(poll_after_change(state, load_prefs()))
            return
        with require_player() as player:
            prefs = load_prefs()
            count_listening(state, listen_snap(player), prefs)
            before = player.get("time-pos")
            record = state.get("stream")
            if isinstance(record, dict):
                asked = record.get("asked")
                if (isinstance(asked, (int, float)) and isinstance(before, (int, float))
                        and before >= asked - START_SLACK):
                    # It did start where it was asked (before any poll saw
                    # so): a seek back from there is yours to sync. On a host
                    # without byte ranges the floor stays (a seek there may
                    # not land) until playback passes it.
                    record["asked"] = None
                record["begun"] = None  # a break after a seek isn't "nothing more arrives"
            # osd-msg-bar: the video window (if shown) shows where it went.
            if args.relative:
                player.command("osd-msg-bar", "seek", float(args.seconds), "relative")
            else:
                player.command("osd-msg-bar", "seek", max(0.0, float(args.seconds)), "absolute")
            time.sleep(0.05)
            after = player.get("time-pos")
            if (args.relative and isinstance(before, (int, float))
                    and isinstance(after, (int, float)) and after > before):
                add_stats(skipping=after - before)  # the skip-forward button's time saved
            state["listening"] = {}  # a new count from here: the jump itself isn't listening
            count_listening(state, listen_snap(player), prefs)
            playing = player.get("pause") is False and player.get("eof-reached") is not True
            if playing and ended_here(state):
                # Dragged back from the end of an episode that ended here
                # while mpv still played (it pauses itself at the end a
                # moment later; paused, Play plays it again from here).
                play_again(player, state, from_start=False)
            else:
                # While paused, sync_now's rule decides: a seek right after
                # pausing is sent; later, the next resume asks Pocket Casts.
                sync_now(player, state, force=playing and not state.get("checkServer"))
        view = poll_after_change(load_playback(), load_prefs())
    out(view)


def cmd_volume(args):
    volume = max(0, min(100, int(args.percent)))
    with prefs_update() as prefs:
        prefs["volume"] = volume
        player = Mpv.connect()
        if player:
            with player:
                player.set("volume", volume)
                osd(player, "Volume %d%%" % volume)
    out({"volume": volume})


@contextlib.contextmanager
def listening_change():
    """Around a speed or Trim change: count the stretch so far at the old
    setting, and start a new count at the new one (count_listening drops a
    stretch whose speed or Trim changed in the middle). Only if the state
    lock is free within half a second: a speed change never waits behind a
    slow poll for the sake of the stats."""
    try:
        lock = StateLock(timeout=0.5)
        lock.__enter__()
    except ApiError:
        yield
        return
    try:
        state = load_playback()
        player = Mpv.connect()
        if player:
            with player:
                count_listening(state, listen_snap(player), load_prefs())
        yield
        state["listening"] = {}
        player = Mpv.connect()
        if player:
            with player:
                count_listening(state, listen_snap(player), load_prefs())
        save_playback(state)
    finally:
        lock.__exit__(None, None, None)


def cmd_speed(args):
    with listening_change(), prefs_update() as prefs:
        if args.value == "cycle":
            current = clamp_speed(prefs.get("speed", 1.0))
            later = [s for s in SPEEDS if s > current + 0.001]
            speed = later[0] if later else SPEEDS[0]
        else:
            speed = clamp_speed(args.value)
        prefs["speed"] = speed
        player = Mpv.connect()
        if player:
            with player:
                player.set("speed", speed)
                osd(player, "Speed %s×" % ("%.2f" % speed).rstrip("0").rstrip("."))
    out({"speed": speed})


# ------------------------------------------------------------ before sleep
#
# While an episode is loaded, the panel runs `sleepguard` under
# `systemd-inhibit --what=sleep --mode=delay`: when logind announces a sleep
# (PrepareForSleep), the episode is paused and its position sent to Pocket
# Casts, then the guard exits, which releases the delay and lets the sleep go
# ahead. So a closed lid hands over cleanly to the phone, and nothing plays
# on behind the lock screen after waking. logind allows a delay of seconds,
# so the push gets a short deadline of its own.

SLEEP_PUSH_TIMEOUT = 4
SLEEP_GUARD_DEADLINE = 10


def wait_for_sleep(lines):
    """True once dbus-monitor reports PrepareForSleep(true); False if its
    output ends first.

    Only a broadcast counts: logind's PrepareForSleep has no destination.
    The match rule's sender filter only applies to broadcasts, so a signal
    sent straight to the monitor by another local account (it shows a
    destination) is ignored, as is anything but login1's own signal."""
    broadcast = False
    for line in lines:
        text = line.strip()
        if text.startswith("signal "):
            broadcast = ("destination=(null destination)" in text
                         and "path=/org/freedesktop/login1;" in text
                         and "interface=org.freedesktop.login1.Manager;" in text
                         and text.endswith("member=PrepareForSleep"))
        elif text.startswith(("method ", "error ")):
            broadcast = False
        elif broadcast and text == "boolean true":
            return True
    return False


def pause_for_sleep():
    """Pause a playing episode and push its position, quickly: with the
    current sign-in only (no refresh, REFRESH_ALLOWED)."""
    global HTTP_TIMEOUT, REFRESH_ALLOWED
    HTTP_TIMEOUT = SLEEP_PUSH_TIMEOUT
    REFRESH_ALLOWED = False
    player = Mpv.connect(timeout=1.0)
    if not player:
        return False
    with player:
        if player.get("pause") is not False or player.get("eof-reached") is True:
            return False
        # Paused first, before the state lock: a poll pushing on a slow link
        # can hold that for many seconds, and the machine is about to sleep.
        player.set("pause", True)
        try:
            lock = StateLock(timeout=2)
            lock.__enter__()
        except ApiError:
            # Paused, not pushed: the poll that sees the pause sets
            # checkServer, and the next resume asks Pocket Casts first.
            return True
        try:
            state = load_playback()
            sync_now(player, state, force=True)  # nothing if unconfirmed, unchecked or stalled (sync_now)
            state["checkServer"] = True  # the next resume asks first
            save_playback(state)
        finally:
            lock.__exit__(None, None, None)
    return True


def cmd_sleepguard(args):
    monitor = trusted_tool("dbus-monitor")
    setpriv = trusted_tool("setpriv")
    if not monitor or not setpriv:
        raise ApiError("no_dbus", "dbus-monitor and setpriv are needed to pause before sleep")
    # Stopped by the panel (the episode was unloaded): close the monitor too.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    # The monitor also ends if this process is killed outright.
    proc = subprocess.Popen([setpriv, "--pdeathsig", "TERM", monitor, "--system",
                             "type='signal',sender='org.freedesktop.login1',"
                             "interface='org.freedesktop.login1.Manager',member='PrepareForSleep'"],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=child_env(), text=True)
    try:
        sleeping = wait_for_sleep(proc.stdout)
    finally:
        proc.terminate()
    if not sleeping:
        # The monitor ended without announcing a sleep (D-Bus restarted, say):
        # a failure, so the service backs off instead of restarting it at once.
        raise ApiError("sleepguard", "The sleep monitor stopped before any sleep")
    # The whole pause and push within SLEEP_GUARD_DEADLINE (logind waits 15 s
    # at most): a push that waited on a lock could go out after the machine
    # slept and woke, over whatever was played meanwhile.
    signal.signal(signal.SIGALRM, _deadline_passed)
    signal.alarm(SLEEP_GUARD_DEADLINE)
    try:
        paused = pause_for_sleep()
    except DeadlinePassed:
        raise ApiError("sleepguard", "Pausing before sleep took too long")
    finally:
        signal.alarm(0)
    out({"sleeping": sleeping, "paused": paused})


def cmd_video(args):
    with StateLock():
        prefs = load_prefs()
        with require_player() as player:
            show = not video_shown(player.snapshot()) if args.value == "toggle" else args.value == "on"
            set_video(player, prefs, show)
        view = poll_after_change(load_playback(), prefs)
    out(view)


def cmd_boost(args):
    with prefs_update() as prefs:
        on = not (prefs.get("boost") is True) if args.value == "toggle" else args.value == "on"
        prefs["boost"] = on
        player = Mpv.connect()
        if player:
            with player:
                apply_boost(player, on)
                osd(player, "Volume Boost %s" % ("on" if on else "off"))
    out({"boost": on})


def cmd_videopin(args):
    """Always on top for the video window (its right-click menu): pins or
    unpins the open window now, and new windows open the same way."""
    with prefs_update() as prefs:
        pinned = not video_pinned(prefs) if args.value == "toggle" else args.value == "on"
        prefs["videoPinned"] = pinned
        # The rules first (for windows opened later), then the pin: Hyprland
        # re-tags the open window as its pin changes (video_rule_lua).
        place_video_window(prefs)
        hyprctl("dispatch", 'hl.dsp.window.pin({ action = "%s", window = "class:^%s$" })'
                % ("on" if pinned else "off", VIDEO_APP_ID))
        player = Mpv.connect()
        if player:
            with player:
                try:
                    player.command("set_property", "menu-data", video_menu(prefs))
                    player.command("show-text", "Always on top: %s" % ("on" if pinned else "off"), 1500)
                except ApiError:
                    pass
    out({"videoPinned": pinned})


def cmd_videotransparency(args):
    """How see-through the video window is (its right-click menu, or the
    Settings page): the open window changes now, new ones open that way."""
    with prefs_update() as prefs:
        prefs["videoTransparency"] = args.value
        place_video_window(prefs)  # the level, to the open window and the hook
        player = Mpv.connect()
        if player:
            with player:
                try:
                    player.command("set_property", "menu-data", video_menu(prefs))
                    player.command("show-text", "Transparency: %s" % transparency_label(args.value).lower(), 1500)
                except ApiError:
                    pass
    out({"videoTransparency": args.value})


def cmd_trim(args):
    if args.value != "cycle" and args.value not in TRIM_LEVELS:
        raise ApiError("bad_args", "Trim Silence is off, mild, medium or madmax")
    with listening_change(), prefs_update() as prefs:
        if args.value == "cycle":
            current = TRIM_ORDER.index(trim_level(prefs.get("trim")))
            level = TRIM_ORDER[(current + 1) % len(TRIM_ORDER)]
        else:
            level = args.value
        prefs["trim"] = level
        player = Mpv.connect()
        if player:
            with player:
                apply_trim(player, level)
                osd(player, "Trim Silence: %s" % TRIM_NAMES.get(level, level))
    out({"trim": level})


def cmd_next(args):
    """Skip to the next Up Next episode. The skipped one keeps its position
    and leaves Up Next, the way the Pocket Casts apps do it."""
    with StateLock():
        prefs = load_prefs()
        state = load_playback()
        episode = state.get("episode") or {}
        player = Mpv.connect()
        if player:
            with player:
                sync_now(player, state)  # (play_item's save_outgoing counts the listening)
        if episode.get("uuid"):
            try:
                up_next_remove([episode["uuid"]])
            except ApiError:
                pass
        item = next_in_up_next(episode.get("uuid", ""))
        if not item:
            raise ApiError("nothing_queued", "Up Next is empty")
        play_item(item, prefs, queue=False)
        view = poll_after_change(load_playback(), prefs)
    out(view)


def cmd_stop(args):
    with StateLock():
        state = load_playback()
        player = Mpv.connect()
        if player and not player.responsive():
            end_hung_player(player)
            out(player_view({}, load_playback(), load_prefs()))
            return
        if player and args.if_paused and player.get("pause") is False and player.get("eof-reached") is not True:
            # The panel's idle unload, but something (a media key) resumed
            # playback since: leave it playing.
            with player:
                view = player_view(player.snapshot(), state, load_prefs())
            out(view)
            return
        if player:
            count_listening(state, listen_snap(player), load_prefs())
            sync_now(player, state)
            quit_mpv(player)
        view = player_view({}, load_playback(), load_prefs())
    out(view)


NOTIFY_MAX = 300


def cmd_notify(args):
    """A desktop notification (`notify-send`, which Omarchy's shell shows and
    keeps in its notification list): how the panel's errors reach you while
    it's closed. Omarchy's OSD takes no messages from a third-party plugin
    (its shell answers such a summon with false). The text is one argument
    after `--`, never parsed as an option, and capped."""
    tool = trusted_tool("notify-send")
    if not tool:
        raise ApiError("no_notify", "notify-send isn't installed")
    text = " ".join(str(args.text or "").split())[:NOTIFY_MAX]
    try:
        subprocess.run([tool, "--app-name=Legato", "--urgency=normal", "--", "Legato", text],
                       env=child_env(), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=5, check=False)
    except (OSError, subprocess.TimeoutExpired):
        raise ApiError("notify", "The notification couldn't be sent")
    out({"sent": True})


def cmd_stats(args):
    """The listening stats counted on this computer (stats.json), after an
    optional change: `on` / `off` (counting, in prefs.json) or `clear`
    (deletes stats.json, under the state lock so a poll counting at that
    moment can't write the old numbers back). A plain read takes no lock:
    writes replace the file whole (rename), so a read sees one or the other,
    and the page isn't kept waiting behind a slow poll."""
    if args.value in ("on", "off"):
        with prefs_update() as prefs:
            prefs["stats"] = args.value == "on"
    elif args.value == "clear":
        with StateLock():
            drop_state("stats.json")
    stats = load_stats()
    number = lambda value: float(value) if isinstance(value, (int, float)) else 0.0
    view = {key: number(stats.get(key)) for key in STATS_KEYS}
    view["finished"] = int(number(stats.get("finished")))
    view["since"] = int(stats["since"]) if isinstance(stats.get("since"), (int, float)) else 0
    view["counting"] = stats_counting(load_prefs())
    out(view)


def cmd_mark(args):
    uuid = safe_uuid(args.uuid)
    podcast = safe_uuid(args.podcast)
    item = {"uuid": uuid, "podcast": podcast}
    if args.state == "played":
        push_position(item, 0, STATUS_PLAYED)
        try:
            up_next_remove([uuid])
        except ApiError:
            pass
    else:
        push_position(item, 0, STATUS_UNPLAYED)
    out({"uuid": uuid, "status": STATUS_PLAYED if args.state == "played" else STATUS_UNPLAYED})


def cmd_queue(args):
    uuid = safe_uuid(args.uuid)
    if args.where == "remove":
        up_next_remove([uuid])
        out({"uuid": uuid})
        return
    item = resolve_episode(uuid, safe_uuid(args.podcast) if args.podcast else "")
    up_next_put(item, args.where)
    out({"uuid": uuid})


def cmd_up_next(args):
    items = up_next_items()[: args.limit]
    out({"items": cache_art(items)})


def episode_list(path):
    payload = api(path)
    titles = None
    items = []
    for e in payload.get("episodes") or []:
        item = norm_episode(e)
        if not item:
            continue
        if not item["show"]:
            titles = titles if titles is not None else podcast_titles()
            item["show"] = titles.get(item["podcast"], "")
        items.append(item)
    return items


def cmd_in_progress(args):
    items = episode_list("/user/in_progress")
    items.sort(key=lambda i: i.get("published") or "", reverse=True)
    out({"items": cache_art(items[: args.limit])})


def cmd_new_releases(args):
    items = episode_list("/user/new_releases")
    items.sort(key=lambda i: i.get("published") or "", reverse=True)
    out({"items": cache_art(items[: args.limit])})


def cmd_podcasts(args):
    out({"items": cache_art(subscriptions(force=args.force))})


def cmd_episodes(args):
    podcast_uuid = safe_uuid(args.podcast)
    show = fetch_show(podcast_uuid)
    try:
        user = api("/user/podcast/episodes", {"uuid": podcast_uuid})
    except ApiError as err:
        if err.code in ("signed_out", "reauth"):
            raise
        user = {}
    states = {}
    for s in user.get("episodes") or []:
        if isinstance(s, dict) and s.get("uuid"):
            states[str(s["uuid"]).lower()] = s
    title = show.get("title") or ""
    items = []
    for e in show.get("episodes") or []:
        item = norm_episode(e, podcast_uuid, title, sync=states.get(str((e or {}).get("uuid") or "").lower()))
        if item and not (states.get(item["uuid"]) or {}).get("isDeleted"):
            items.append(item)
    items.sort(key=lambda i: i.get("published") or "", reverse=True)
    header = {"type": "podcast", "uuid": podcast_uuid, "name": text(title, 200) or "Podcast",
              "author": text(show.get("author"), 200), "art": podcast_art(podcast_uuid)}
    cache_art([header])
    out({"podcast": header, "items": cache_art(items[: args.limit]), "total": len(items)})


# --------------------------------------------------------------------- main

def build_parser():
    parser = argparse.ArgumentParser(prog="legato-bridge", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status").set_defaults(fn=cmd_status)
    sub.add_parser("login").set_defaults(fn=cmd_login)
    p = sub.add_parser("paste"); p.add_argument("--primary", action="store_true"); p.set_defaults(fn=cmd_paste)
    p = sub.add_parser("proxy"); p.add_argument("--watch-pid", type=int, required=True); p.set_defaults(fn=cmd_proxy)
    p = sub.add_parser("localfeeds"); p.add_argument("value", choices=("on", "off", "toggle")); p.set_defaults(fn=cmd_localfeeds)
    sub.add_parser("logout").set_defaults(fn=cmd_logout)

    p = sub.add_parser("player"); p.add_argument("--no-autoplay", action="store_true")
    p.add_argument("--seeked", action="store_true")  # mpv reported a seek since the last poll (listening stats)
    p.set_defaults(fn=cmd_player)
    p = sub.add_parser("play"); p.add_argument("uuid"); p.add_argument("--podcast", default="")
    p.add_argument("--from-start", action="store_true"); p.set_defaults(fn=cmd_play)
    for action in ("toggle", "pause", "resume"):
        sub.add_parser(action).set_defaults(fn=cmd_toggle, action=action)
    p = sub.add_parser("seek"); p.add_argument("seconds", type=float); p.add_argument("--relative", action="store_true")
    p.add_argument("--episode", default="")  # the episode the seek was meant for; refused if another is loaded
    p.set_defaults(fn=cmd_seek)
    p = sub.add_parser("volume"); p.add_argument("percent", type=int); p.set_defaults(fn=cmd_volume)
    p = sub.add_parser("speed"); p.add_argument("value"); p.set_defaults(fn=cmd_speed)
    p = sub.add_parser("trim"); p.add_argument("value"); p.set_defaults(fn=cmd_trim)
    p = sub.add_parser("video"); p.add_argument("value", choices=("on", "off", "toggle")); p.set_defaults(fn=cmd_video)
    p = sub.add_parser("videopin"); p.add_argument("value", choices=("on", "off", "toggle")); p.set_defaults(fn=cmd_videopin)
    p = sub.add_parser("videotransparency"); p.add_argument("value", type=int, choices=TRANSPARENCY_LEVELS)
    p.set_defaults(fn=cmd_videotransparency)
    p = sub.add_parser("boost"); p.add_argument("value", choices=("on", "off", "toggle")); p.set_defaults(fn=cmd_boost)
    sub.add_parser("sleepguard").set_defaults(fn=cmd_sleepguard)
    sub.add_parser("next").set_defaults(fn=cmd_next)
    p = sub.add_parser("stop"); p.add_argument("--if-paused", action="store_true"); p.set_defaults(fn=cmd_stop)
    p = sub.add_parser("stats"); p.add_argument("value", nargs="?", choices=("on", "off", "clear"))
    p.set_defaults(fn=cmd_stats)

    p = sub.add_parser("notify"); p.add_argument("text"); p.set_defaults(fn=cmd_notify)

    p = sub.add_parser("mark"); p.add_argument("state", choices=("played", "unplayed")); p.add_argument("uuid")
    p.add_argument("--podcast", required=True); p.set_defaults(fn=cmd_mark)
    p = sub.add_parser("queue"); p.add_argument("where", choices=("next", "last", "remove")); p.add_argument("uuid")
    p.add_argument("--podcast", default=""); p.set_defaults(fn=cmd_queue)

    p = sub.add_parser("up-next"); p.add_argument("--limit", type=int, default=100); p.set_defaults(fn=cmd_up_next)
    p = sub.add_parser("in-progress"); p.add_argument("--limit", type=int, default=50); p.set_defaults(fn=cmd_in_progress)
    p = sub.add_parser("new-releases"); p.add_argument("--limit", type=int, default=50); p.set_defaults(fn=cmd_new_releases)
    p = sub.add_parser("podcasts"); p.add_argument("--force", action="store_true"); p.set_defaults(fn=cmd_podcasts)
    p = sub.add_parser("episodes"); p.add_argument("podcast"); p.add_argument("--limit", type=int, default=100); p.set_defaults(fn=cmd_episodes)
    return parser


# Any one call that runs longer than this is stuck (a DNS lookup that never
# answers, say): it ends with an error instead of holding the state lock.
BRIDGE_DEADLINE = 120


class DeadlinePassed(BaseException):
    """Not an Exception: the handlers that shrug off a failed push or cover
    (`except ApiError`, `except Exception`) must not swallow the deadline."""


_DEADLINE = {"holding": False, "passed": False}


def _deadline_passed(signum, frame):
    if _DEADLINE["holding"]:
        _DEADLINE["passed"] = True  # raised when the hold ends (deadline_held)
        return
    raise DeadlinePassed()


@contextlib.contextmanager
def deadline_held():
    """Within this, the call's deadline waits: it's raised on the way out."""
    _DEADLINE["holding"] = True
    try:
        yield
    finally:
        _DEADLINE["holding"] = False
        if _DEADLINE["passed"]:
            _DEADLINE["passed"] = False
            raise DeadlinePassed()


def main(argv):
    scrub_environment()
    args = build_parser().parse_args(argv)
    timed = args.command not in ("sleepguard", "proxy") and threading.current_thread() is threading.main_thread()
    if timed:
        signal.signal(signal.SIGALRM, _deadline_passed)
        signal.alarm(BRIDGE_DEADLINE)
    try:
        args.fn(args)
        return 0
    except ApiError as err:
        fail(err.code, err.message, {"status": err.status, "retryAfter": err.retry_after})
        return 0
    except KeyboardInterrupt:
        fail("cancelled", "Cancelled")
        return 0
    except DeadlinePassed:
        fail("timeout", "Legato's helper took over %d seconds and gave up" % BRIDGE_DEADLINE)
        return 0
    except Exception as err:  # noqa: BLE001 — surfaced to the panel as text
        fail("internal", "%s: %s" % (type(err).__name__, err))
        return 1
    finally:
        if timed:
            signal.alarm(0)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
