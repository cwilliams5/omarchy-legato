{
  "schemaVersion": 1,
  "id": "io.github.cwilliams5.legato",
  "name": "Legato",
  "version": "0.2.0",
  "author": "Cody Williams",
  "license": "MIT",
  "homepage": "https://github.com/cwilliams5/omarchy-legato",
  "description": "A Pocket Casts player in the Omarchy bar that keeps your place across your phone and computers: Up Next, in-progress and new episodes through mpv, your shows, and a resume that always asks Pocket Casts first. Unofficial.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Legato",
    "description": "Now playing in the bar; click for the player, Up Next, In Progress, New releases and your shows. Keeps your place in step with Pocket Casts on your other devices.",
    "category": "Media",
    "aliases": [
      "legato",
      "pocketcasts",
      "pocket casts",
      "podcasts",
      "podcast"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showTitle": true,
      "scrollTitle": false,
      "maxLabelWidth": 180,
      "defaultTab": "upnext",
      "skipBack": 10,
      "skipForward": 30,
      "autoplay": true,
      "unloadAfterMinutes": 15,
      "pauseOnSleep": true
    },
    "schema": [
      {
        "key": "showTitle",
        "type": "boolean",
        "label": "Show the episode title next to the cover",
        "defaultValue": true
      },
      {
        "key": "scrollTitle",
        "type": "boolean",
        "label": "Scroll a title that doesn't fit (otherwise it's cut off with …)",
        "defaultValue": false
      },
      {
        "key": "maxLabelWidth",
        "type": "integer",
        "label": "Max width of the title label (px)",
        "min": 60,
        "max": 600,
        "step": 10,
        "defaultValue": 180
      },
      {
        "key": "defaultTab",
        "type": "enum",
        "label": "Tab to open first",
        "options": [
          "upnext",
          "progress",
          "new",
          "podcasts"
        ],
        "defaultValue": "upnext"
      },
      {
        "key": "skipBack",
        "type": "integer",
        "label": "Skip back (seconds)",
        "min": 5,
        "max": 120,
        "step": 5,
        "defaultValue": 10
      },
      {
        "key": "skipForward",
        "type": "integer",
        "label": "Skip forward (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "autoplay",
        "type": "boolean",
        "label": "Play the next Up Next episode when one finishes",
        "defaultValue": true
      },
      {
        "key": "unloadAfterMinutes",
        "type": "integer",
        "label": "Unload the player after this many minutes paused (0 = never). Media keys can't reach an unloaded player",
        "min": 0,
        "max": 240,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "pauseOnSleep",
        "type": "boolean",
        "label": "Pause and save your place before the computer sleeps",
        "defaultValue": true
      }
    ]
  }
}
